  { label: 'FAQs on the IT (Intermediary Guidelines) Amendment Rules 2026', href: 'https://www.meity.gov.in/static/uploads/2025/10/065b6deb585441b5ccdf8be42502a49c.pdf', publisher: 'Ministry of Electronics and IT', date: '10 Feb 2026' },
