const path = '/safeguarding/';
const crumbs = [{ name: 'Safeguarding', href: path }];
const description =
  'How Cultural Shock Party keeps children and adults safe: no sign-ups from under-18s, no one-to-one adult contact, POCSO reporting, and how to raise a concern.';
const CONCERN = '/contact/?topic=safeguarding#contact-form';

const TOC = [
  { id: 'commitment', n: '01', title: 'Our commitment' },
  { id: 'under-18', n: '02', title: 'Under 18: learn, don’t sign up' },
  { id: 'pocso', n: '03', title: 'If a child is being harmed' },
  { id: 'harassment', n: '04', title: 'Sexual harassment' },
  { id: 'concern', n: '05', title: 'How to raise a concern' },
  { id: 'helplines', n: '06', title: 'Helplines' },
  { id: 'online', n: '07', title: 'Staying safe online' },
  { id: 'scope', n: '08', title: 'Who this covers' },
];

const CHILD_STEPS = [
  { t: 'Make the child safe', d: 'If a child is in danger right now, call <a href="tel:112">112</a> or the Child Helpline, <a href="tel:1098">1098</a>. Don’t wait for us.' },
  { t: 'Report it to the police', d: 'Whoever at CSP receives the concern tells the police or the Special Juvenile Police Unit straight away, as the law requires. <strong>We never investigate first</strong>, and we never ask a child to repeat their story.' },
  { t: 'Write it down, keep it locked', d: 'We record what was said and done, in the words used, with the date and time, and keep the record confidential.' },
  { t: 'Protect, never expose', d: 'We never name or identify the child. Anyone in CSP who is involved steps back from all CSP activity while the police act.' },
  { t: 'Support the people involved', d: 'We point the child and their family to support, such as the Child Helpline, and we check in with the person who told us.' },
];

const ONLINE = [
  { t: 'Save the proof', d: 'Screenshot posts and messages with the link, date and time before you report or block anyone.' },
  { t: 'Don’t reply, don’t pay', d: 'If someone threatens to share your images, don’t pay and don’t argue. It is not your fault. Report it.' },
  { t: 'Report it fast', d: 'Since 20 February 2026, platforms in India must remove intimate, nude or morphed images, including deepfakes, within 2 hours of a complaint.<sup><a class="fn-ref" href="#src-6">6</a></sup> Report crime at <a href="https://cybercrime.gov.in/" rel="noopener">cybercrime.gov.in</a> or on 1930.' },
  { t: 'Lock your accounts', d: 'Turn on two-step login, and check who can see your posts, your friends list and your location.' },
];

const SOURCES = [
  { label: 'Protection of Children from Sexual Offences Act 2012, sections 19 to 23', href: 'https://vidhijudicial.com/sec-19-to-23-chapter-v-(procedure-for-reporting-of-cases)-the-protection-of-children-from-sexual-offences-act,-2012.html', publisher: 'Vidhi Judicial (text and summary)', date: 'opened 24 Oct 2026' },
  { label: 'Sexual Harassment of Women at Workplace (Prevention, Prohibition and Redressal) Act 2013 (gazette copy)', href: 'https://www.iimshillong.ac.in/wp-content/uploads/2024/06/3.-Sexual-Harassment-of-Women-at-Workplace-Act-2013.pdf', publisher: 'Government of India, hosted by IIM Shillong', note: 'Sections 2(f), 2(o), 4 and 6.' },
  { label: 'Supreme Court declines to interfere with Kerala High Court ruling that political parties are not POSH workplaces', href: 'https://www.scconline.com/blog/post/2025/09/17/supreme-court-kerala-hc-political-parties-not-workplace-posh-act-2013/', publisher: 'SCC Online', date: '17 Sep 2025' },
  { label: 'SHe-Box: Sexual Harassment electronic Box', href: 'https://shebox.wcd.gov.in/', publisher: 'Ministry of Women and Child Development', date: 'opened 24 Oct 2026' },
