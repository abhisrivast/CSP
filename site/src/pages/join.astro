---
// /join/ — Join the movement: the five-rung engagement ladder as the spine, six roles, the DPDP-aligned
// Join form (age band first), a no-sign-up path, the allies note and a FAQ teaser.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import JoinHero from '../components/participate/JoinHero.astro';
import LadderSpine, { type Rung } from '../components/participate/LadderSpine.astro';
import RoleTrack, { type Role } from '../components/participate/RoleTrack.astro';
import JoinForm from '../components/participate/JoinForm.astro';
import QA from '../components/participate/QA.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Ticker from '../components/ui/Ticker.astro';
import TornEdge from '../components/ui/TornEdge.astro';
import Annotation from '../components/ui/Annotation.astro';
import Receipt from '../components/ui/Receipt.astro';
import Placard from '../components/ui/Placard.astro';
import Shot from '../components/participate/Shot.astro';
import ShareBar from '../components/blocks/ShareBar.astro';
import JoinBand from '../components/blocks/JoinBand.astro';

const path = '/join/';
const title = 'Join the movement: start where you are';
const description =
  'Join Cultural Shock Party, a Fourth Wave feminist movement founded in India. It’s free: pick a rung, from five minutes on your phone to the street. Boys too.';
const crumbs = [{ name: 'Join', href: path }];

const rungs: Rung[] = [
  {
    id: 'rung-phone', where: 'On your phone', time: 'About 5 minutes', roles: 'Reader · Signer',
    text: 'Read one thing properly, check where the numbers come from, and put your name to what you believe.',
    actions: [
      { verb: 'Read', label: 'The Fourth Wave, in plain words', href: '/resources/what-is-fourth-wave-feminism/' },
      { verb: 'Check', label: 'Ten myths about feminism, with the receipts', href: '/resources/feminism-myths-and-receipts/' },
      { verb: 'Sign', label: 'Add your name to the manifesto', href: '/manifesto/#sign' },
    ],
    photo: { id: 'in-056-woman-in-blue-sari-reading-outdoors', tone: 'red', position: '45% 50%', alt: 'A woman in a blue sari sits on a blanket under trees, reading a book.' },
  },
  {
    id: 'rung-chat', where: 'In the group chat', time: 'About 10 minutes', roles: 'Sharer',
    text: 'Most of us already want this. Say it where your friends already are: kindly, and with a source.',
    actions: [
      { verb: 'Share', label: 'Pick one guide and send it to the group chat', href: '/resources/' },
      { verb: 'Explain', label: 'Borrow a plain definition from the glossary', href: '/resources/glossary/' },
      { verb: 'Invite', label: 'Bring a friend. Yes, boys too', href: '#allies' },
    ],
    photo: { id: '070-women-hijab-and-saree-street', tone: 'ink', position: '40% 40%', alt: 'A group of women in hijabs and saris laugh and talk together on a street.' },
  },
  {
    id: 'rung-campus', where: 'At school, college or work', time: 'An hour a week', roles: 'Member',
    text: 'Find two or three people and start something small that meets regularly. Small and steady beats big and once.',
    actions: [
      { verb: 'Start', label: 'A feminist group at your college', href: '/resources/how-to-join-or-start-a-feminist-group/' },
      { verb: 'Read together', label: 'The Fourth Wave reading (and watching) list', href: '/resources/fourth-wave-reading-list/' },
      { verb: 'Ask', label: 'Who sits on your workplace’s POSH committee?', href: '/case-studies/bhanwari-devi-vishaka-posh/' },
    ],
    photo: { id: 'in-033-2014-varanasi-bhu-women-medical-students', tone: 'red', position: '50% 55%', alt: 'Four young women in white coats and backpacks walk together along a campus road, seen from behind.', caption: 'Banaras Hindu University, Varanasi, 14 February 2014.' },
  },
  {
    id: 'rung-street', where: 'On the street', time: 'A Saturday', roles: 'Organiser',
    text: 'Peaceful, lawful, joyful and never alone. Learn the rules before you go, and go with friends.',
    actions: [
      { verb: 'Read first', label: 'How to show up safely: protest safety in India', href: '/resources/protest-safety-india/' },
      { verb: 'Learn from', label: 'Reclaim the Night: Bengal, August 2024', href: '/case-studies/reclaim-the-night-bengal-2024/' },
      { verb: 'Get invited', label: 'Tick “events in my state” on the form below', href: '#join-form' },
    ],
    photo: { id: 'in-061-delhi-women-equal-pay-for-equal-work-placard', tone: 'marigold', position: '50% 35%', alt: 'A masked woman holds up a hand-lettered placard reading Equal pay for equal work.', caption: 'An equal-pay protest, 25 December 2021.' },
  },
  {
    id: 'rung-institutions', where: 'In the institutions', time: 'The long haul', roles: 'Lead',
    text: 'Make institutions answer: in public, with records, and with the Constitution in your hand.',
    actions: [
      { verb: 'Track', label: 'The Women’s Reservation Act: what passed, what’s stalled', href: '/resources/womens-reservation-act-explained/' },
      { verb: 'Hold to account', label: 'Promise trackers and open letters: the Accountability Watch', href: '/what-we-do/#accountability-watch' },
      { verb: 'Learn how', label: 'Delhi 2012: how protest became law', href: '/case-studies/delhi-2012-justice-verma/' },
    ],
    photo: { id: 'in-028-2026-assam-woman-inked-finger-after-voting', tone: 'green', position: '50% 30%', alt: 'A smiling woman under a polka-dot umbrella holds up a finger marked with voting ink.', caption: 'After voting, Dimoria, Assam, 9 April 2026.' },
  },
];

const roles: Role[] = [
  { name: 'Reader', how: 'You read, and you check the receipts.', needs: 'No sign-up' },
  { name: 'Sharer', how: 'You pass it on to the people you know, kindly.', needs: 'No sign-up' },
  { name: 'Signer', how: 'You add your name to the Fourth Wave Manifesto.', needs: 'Sign the manifesto' },
  { name: 'Member', how: 'You join with the form on this page and hear from us.', needs: '18+ · an email' },
  { name: 'Organiser', how: 'You run a reading circle, a teach-in or a campus group, with our support.', needs: '18+' },
  { name: 'Lead', how: 'You coordinate a campus, a city or a campaign, and help others step up.', needs: '18+' },
];

const RULES = [
  { h: 'Peaceful and lawful, always.', p: 'Permitted places, permitted times. Shock the culture, not people.' },
  { h: 'No slurs. None.', p: 'Nothing gendered, casteist, communal, homophobic or transphobic, and no body-shaming. Disagree with ideas, not with people’s bodies.' },
  { h: 'Ask before you photograph.', p: 'Never post faces without consent, and never photograph children.' },
  { h: 'Criticise institutions, not voters.', p: 'Laws, systems and the people who run them in public are fair game. Private lives are not.' },
  { h: 'No party flags.', p: 'Cultural Shock Party is independent. Party flags, symbols and slogans stay at home.' },
];

const faqIds = ['how-old-do-i-need-to-be', 'can-boys-and-men-join', 'do-i-have-to-protest', 'what-happens-to-my-data', 'is-it-safe-to-come-to-an-action'];
const faq = await getCollection('faq');
const faqItems = faqIds.map((id) => faq.find((e) => e.data.id === id)!.data);
---
<Base
  title={title}
  description={description}
  pageType="WebPage"
  breadcrumbs={crumbs}
  image="/og/join.png"
  imageAlt="Join the movement: start where you are. Bring a friend. Yes, boys too."
  modified="2026-10-24"
>
  <JoinHero crumbs={crumbs} />

  <Ticker items={['Start where you are', 'Bring a friend', 'Yes, boys too']} tone="ink" />

  <!-- 01 The ladder -->
  <section class="section ground-light ladder" id="ladder" aria-labelledby="ladder-title">
    <div class="wrap">
      <div class="ladder__head">
        <SectionHead num="01" label="The ladder" id="ladder-title" title="Five rungs. Start on any." lead="You don’t have to do everything. Pick the rung that fits your week, then climb when you’re ready. The rungs ask more of you as they go down, and every single one counts." />
        <div class="ladder__note" aria-hidden="true"><Annotation text="most people start here" arrow="down" tilt={-5} width="12ch" /></div>
      </div>
      <LadderSpine rungs={rungs} />
      <p class="ladder__foot small">Times are rough guides, not targets. Under 18? Reading, sharing and learning are yours today, with no sign-up needed.</p>
    </div>
  </section>

  <!-- 02 Roles -->
  <section class="section ground-ink grain roles-sec" id="roles" aria-labelledby="roles-title">
    <div class="wrap roles-sec__inner">
      <header class="roles-head">
        <p class="label roles-head__label"><span class="roles-head__num">02</span> / Roles</p>
        <h2 class="h2 roles-head__title" id="roles-title">Reader <span class="red">to</span> Lead</h2>
        <div class="roles-head__text">
          <p class="lead">Six roles, one direction. Nobody outranks anybody: you move along when you want to, and you can always step back.</p>
          <p class="roles-head__note small">Under 18? Reader and Sharer are yours today. The rest open up at 18.</p>
        </div>
      </header>
      <RoleTrack roles={roles} />
    </div>
  </section>

  <TornEdge color="var(--paper-deep)" seed={3} />

  <!-- 03 The form -->
  <section class="section ground-deep form-sec" id="join-form" aria-labelledby="form-title">
    <div class="wrap">
      <SectionHead num="03" label="Join" id="form-title" title="Join with the choices you tick" lead="One minute, the minimum of data, and a separate box for everything we might do with it. Nothing is ticked for you." />
      <JoinForm />
    </div>
  </section>

  <!-- 04 No sign-up needed -->
  <section class="section nosign" id="no-signup" aria-labelledby="nosign-title">
    <div class="wrap nosign__grid">
      <div class="nosign__lead">
        <SectionHead num="04" label="No sign-up needed" id="nosign-title" title="Do it right now. No form." lead="No email, no account, nothing to fill in. Three things anyone can do today, at any age." />
        <div class="nosign__pic">
          <Shot id="074-making-a-protest-banner-milan" tone="red" aspect="4 / 5" position="50% 60%" caption={false} tape="tl" tilt={-2}
            alt="Hands tape down a hand-painted banner with big red letters on the ground."
            sizes="(min-width: 900px) 26vw, 70vw" />
          <div class="nosign__placard"><Placard text="Make it, print it, pin it up" color="paper" size="m" tilt={5} decorative /></div>
        </div>
      </div>
      <ol class="nosign__cards" role="list">
        <li class="ns ns--read">
          <p class="ns__n" aria-hidden="true">A</p>
          <h3 class="ns__title">Read</h3>
          <p class="ns__text">Pick one guide and read it properly. Every number has its source and its date, so you can check us.</p>
          <a class="link-arrow" href="/resources/">Browse guides and explainers <span aria-hidden="true">→</span></a>
        </li>
        <li class="ns ns--share">
          <p class="ns__n" aria-hidden="true">B</p>
          <h3 class="ns__title">Share</h3>
          <p class="ns__text">Send this page to one person who would like it. The group chat counts. So does your brother.</p>
          <ShareBar title="Join the movement: Cultural Shock Party" path={path} text="Cultural Shock Party is building the Fourth Wave. Start where you are (yes, boys too)" />
        </li>
        <li class="ns ns--print">
          <p class="ns__n" aria-hidden="true">C</p>
          <h3 class="ns__title">Print</h3>
          <p class="ns__text">Print the manifesto poster for a noticeboard, a hostel door or a staffroom. All twelve positions on one page.</p>
          <a class="link-arrow" href="/manifesto/#poster">Get the manifesto poster <span aria-hidden="true">→</span></a>
        </li>
      </ol>
    </div>
  </section>

  <!-- 05 Allies -->
  <section class="section ground-pink grain allies" id="allies" aria-labelledby="allies-title">
    <div class="wrap allies__grid">
      <div class="allies__text">
        <p class="label allies__label"><span>05</span> / Allies</p>
        <h2 class="h2" id="allies-title">Bring a friend. <span class="red-ink">Yes, boys too.</span></h2>
        <p class="lead allies__lead">Boys and men are invited, and it’s in the manifesto. Feminism is about freedom for everyone, including freedom from rigid ideas of what a man has to be. The problem is the manosphere industry that sells boys loneliness, not boys.</p>
        <a class="link-arrow" href="/resources/boys-men-and-the-manosphere/">Boys, men and the manosphere: a guide for allies <span aria-hidden="true">→</span></a>
      </div>
      <div class="allies__pic">
        <Shot id="in-037-2019-kolkata-pride-workshop-mera-gender-mein-bender" tone="natural" aspect="4 / 5" position="50% 40%" tape="both" tilt={-1.5}
          alt="A young woman and a young man smile as they hold up a yellow hand-lettered poster in Hindi and English."
          caption="A poster-making workshop before the Kolkata Rainbow Pride Walk, 21 December 2019."
          sizes="(min-width: 900px) 30vw, 80vw" />
        <Annotation text="made together" arrow="left" color="ink" tilt={-6} right="-19%" top="30%" width="9ch" />
        <div class="allies__receipt">
          <Receipt figure="69%" label="of Gen Z men across 29 countries do not agree that “a wife should always obey her husband”" source="King’s College London and Ipsos" href="https://www.kcl.ac.uk/news/almost-a-third-of-gen-z-men-agree-a-wife-should-obey-her-husband" date="Mar 2026" tone="paper" tilt={2} />
        </div>
      </div>
      <aside class="rules" aria-labelledby="rules-title">
        <h3 class="rules__title" id="rules-title"><span class="label">Everyone, every rung</span> How we show up</h3>
        <ol class="rules__list" role="list">
          {RULES.map((r, i) => (
            <li><span class="rules__n" aria-hidden="true">{i + 1}</span><span><strong>{r.h}</strong> {r.p}</span></li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <!-- 06 Questions -->
  <section class="section questions" id="questions" aria-labelledby="questions-title">
    <div class="wrap questions__grid">
      <div class="questions__head">
        <SectionHead num="06" label="Questions" id="questions-title" title="Before you join" lead="The five things people ask on this page. Every other answer is on the FAQ." />
        <a class="btn btn--ink" href="/faq/">All 45 answers <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="questions__list">
        {faqItems.map((it, i) => <QA item={it} idPrefix="q-" open={i === 0} />)}
      </div>
    </div>
  </section>

  <JoinBand
    title="Five minutes is a real start."
    text="Read the manifesto, add your name, then send it to one friend. That’s rung one, done."
    primary={{ label: 'Sign the manifesto', href: '/manifesto/#sign' }}
    secondary={{ label: 'Read the FAQ', href: '/faq/' }}
    placard="Start where you are"
  />
</Base>

<style>
  .ladder__head { position: relative; }
  .ladder__head :global(.section-head) { max-width: 820px; }
  .ladder__head :global(.section-head .h2) { max-width: 13ch; }
  .ladder__note { position: absolute; left: min(62%, 780px); bottom: 4px; }
  .ladder__foot { margin-top: 18px; color: var(--muted); }
  .form-sec :global(.section-head .h2), .nosign :global(.section-head .h2) { max-width: 15ch; text-wrap: balance; }

  .roles-sec__inner { position: relative; z-index: 2; }
  .roles-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px clamp(24px, 5vw, 72px); align-items: end; margin-bottom: clamp(28px, 4vw, 48px); }
  .roles-head__label { grid-column: 1 / -1; padding-top: 12px; border-top: 3px solid var(--paper); }
  .roles-head__num { color: var(--coral); font-weight: 900; }
  .roles-head__title { font-size: clamp(3rem, 8vw, 7.5rem); line-height: .82; }
  .roles-head__text { display: grid; gap: 12px; padding-bottom: 6px; }
  .roles-head__note { color: var(--marigold); font-weight: 700; }

  .nosign__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .nosign__lead :global(.section-head) { margin-bottom: 24px; }
  .nosign__pic { position: relative; max-width: 380px; padding-bottom: 30px; }
  .nosign__pic :global(.photo__img) { border: 8px solid var(--paper-light); box-shadow: 6px 7px 0 rgba(29, 28, 24, .2); }
  .nosign__placard { position: absolute; right: -14%; bottom: 0; z-index: 3; }
  .nosign__placard :global(.placard__text) { max-width: 11ch; font-size: clamp(1.15rem, 1.8vw, 1.5rem); }
  .nosign__cards { display: grid; gap: 0; border-top: var(--rule); }
  .ns { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px 22px; padding: clamp(20px, 3vw, 32px) 0; border-bottom: 1px solid var(--line); align-items: start; }
  .ns > :not(.ns__n) { grid-column: 2; }
  .ns__n { grid-row: 1 / 5; display: grid; place-items: center; width: clamp(56px, 6vw, 76px); aspect-ratio: 1; border: 3px solid var(--ink); border-radius: 50%; font-weight: 900; font-stretch: var(--display-stretch); font-size: clamp(2rem, 3vw, 2.6rem); line-height: 1; }
  .ns--read .ns__n { background: var(--marigold); }
  .ns--share .ns__n { background: var(--pink); }
  .ns--print .ns__n { background: var(--red-ink); color: var(--paper-light); border-color: var(--red-ink); }
  .ns__title { font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(2.2rem, 3.6vw, 3.2rem); line-height: .86; }
  .ns__text { color: var(--ink-soft); max-width: 48ch; }
  .ns .link-arrow { justify-self: start; margin-top: 4px; }
  .ns :global(.share) { border: 0; padding-block: 6px 0; }

  .allies__grid {
    position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas: 'pic text' 'pic rules'; gap: 28px clamp(28px, 5vw, 80px); align-items: start;
  }
  .allies__text { grid-area: text; }
  .allies__pic { grid-area: pic; }
  .rules { grid-area: rules; }
  .allies__label span { color: var(--red-ink); font-weight: 900; }
  .allies__pic { position: relative; padding-top: 10px; max-width: 460px; }
  .allies__pic :global(.photo__img) { border: 8px solid var(--paper-light); box-shadow: 6px 7px 0 rgba(29, 28, 24, .22); }
  .allies__pic :global(.photo__credit) { color: #4A463F; }
  .allies__text { display: grid; gap: 20px; align-content: start; }
  .allies__text .h2 { max-width: 11ch; }
  .allies__lead { color: var(--ink); }
  .allies__receipt { width: min(84%, 330px); margin: 22px 0 0 auto; position: relative; z-index: 3; }
  .allies .link-arrow { justify-self: start; border-color: var(--ink); }
  .rules { padding: 22px 22px; background: var(--paper-light); border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .rules__title { display: grid; gap: 6px; font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(1.8rem, 2.6vw, 2.3rem); line-height: .9; margin-bottom: 14px; }
  .rules__title .label { color: var(--red-ink); font-stretch: 100%; }
  .rules__list { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 22px; }
  .rules__list li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; font-size: .93rem; line-height: 1.42; }
  .rules__n { display: grid; place-items: center; width: 26px; height: 26px; background: var(--ink); color: var(--paper-light); font-weight: 900; font-size: .85rem; border-radius: 50%; }

  .questions__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
  .questions__head { position: sticky; top: 96px; display: grid; gap: 4px; justify-items: start; }

  @media (max-width: 1100px) {
    .rules__list { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .nosign__grid, .questions__grid { grid-template-columns: 1fr; }
    .questions__head { position: static; }
    .ladder__note { display: none; }
    .nosign__pic { max-width: 300px; }
    .nosign__placard { right: -18%; }
  }
  @media (max-width: 760px) {
    .allies__grid { grid-template-columns: 1fr; grid-template-areas: 'text' 'pic' 'rules'; }
    .allies__pic { max-width: 380px; width: 92%; }
    .allies__pic :global(.annot) { display: none; }
    .roles-head { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .ns { grid-template-columns: 1fr; }
    .ns > :not(.ns__n) { grid-column: 1; }
    .ns__n { grid-row: auto; width: 52px; font-size: 1.8rem; }
    .nosign__placard { right: -6%; }
  }
  /* SectionHead (shared) prints its number in --red, which is under 4.5:1 at label size on paper; use --red-ink here. */
  :global(main .section-head .section-head__num) { color: var(--red-ink); }
  /* JoinBand (shared): .ground-green a outranks .btn--paper, turning the button label marigold on paper. Keep it ink. */
  :global(.join-band .btn--paper), :global(.join-band .btn--paper:hover) { color: var(--ink); }
</style>
