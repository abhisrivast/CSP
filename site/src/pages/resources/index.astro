---
// /resources/ — "The Journal": the Blog / Resources hub. Masthead, cover story, contents, CSS-only filters
// (radio + :has(), no JS), card grid, glossary teaser, memory + case-study links, newsletter, join.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/media/Photo.astro';
import Card from '../../components/blocks/Card.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Placard from '../../components/ui/Placard.astro';
import Stamp from '../../components/ui/Stamp.astro';
import Ticker from '../../components/ui/Ticker.astro';
import NewsletterForm from '../../components/blocks/NewsletterForm.astro';
import JoinBand from '../../components/blocks/JoinBand.astro';
import TornEdge from '../../components/ui/TornEdge.astro';
import { abs } from '../../lib/schema';
import {
  getArticles, readingMinutes, kindSlug, audienceKeys, AUDIENCES, KINDS, KIND_PLURAL, PILLAR_ID, splitTitle,
} from '../../components/resources/lib';

const articles = await getArticles();
const glossary = await getCollection('glossary');
const cover = articles.find((a) => a.id === PILLAR_ID) ?? articles.find((a) => a.data.featured) ?? articles[0];
const kinds = KINDS.filter((k) => articles.some((a) => a.data.kind === k));
const total = articles.length;

// Empty-state rules for every filter combination that matches nothing (computed at build; still zero JS).
const combos: string[] = [];
for (const k of ['all', ...kinds.map(kindSlug)]) {
  for (const a of ['all', ...AUDIENCES.map((x) => x.key)]) {
    const n = articles.filter((x) => (k === 'all' || kindSlug(x.data.kind) === k) && (a === 'all' || audienceKeys(x.data.audience).includes(a))).length;
    if (n === 0) combos.push(`.find:has(#k-${k}:checked):has(#a-${a}:checked) .find__empty{display:block}`);
  }
}
const emptyCss = combos.join('');

const TEASER_IDS = ['intersectionality', 'patriarchy', 'consent', 'manosphere', 'care-work', 'fourth-wave-feminism'];
const teaser = [
  ...TEASER_IDS.map((id) => glossary.find((g) => g.id === id)).filter(Boolean),
  ...glossary.filter((g) => !TEASER_IDS.includes(g.id)),
].slice(0, 6) as typeof glossary;

const title = 'Resources: guides, explainers and toolkits';
const description = 'Free, plain-language guides, explainers and toolkits on feminism in India and the world: the Fourth Wave, consent, care work, safety online. Every number sourced.';
const schema = [
  {
    '@type': 'ItemList',
    '@id': abs('/resources/') + '#list',
    name: 'The Journal: Cultural Shock Party resources',
    numberOfItems: total,
    itemListElement: articles.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/resources/${a.id}/`), name: a.data.title })),
  },
];
const STRIP = [
  { id: '032-dc-floral-feminist-sign', tone: 'red', tilt: -3 },
  { id: 'in-052-west-bengal-woman-eyes-over-bengali-book', tone: 'ink', tilt: 2 },
  { id: '2024-paris-8m-drums', tone: 'pink', tilt: -1.5 },
  { id: 'in-055-chennai-woman-reading-on-kerb', tone: 'green', tilt: 2.5 },
  { id: 'in-030-2015-jantar-mantar-art-students-bilingual-placards', tone: 'marigold', tilt: -2 },
] as const;
const [coverMain, coverTail] = cover ? splitTitle(cover.data.title) : ['', null];
---
<Base title={title} description={description} pageType="CollectionPage" breadcrumbs={[{ name: 'Resources', href: '/resources/' }]} schema={schema} image="/og/resources.png" bodyClass="page-journal">
  {emptyCss && <Fragment set:html={`<style>${emptyCss}</style>`} />}

  <!-- 01 masthead -->
  <header class="masthead grain">
    <div class="wrap">
      <nav class="crumbs-mini label" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Resources</span></nav>
      <div class="masthead__rule" aria-hidden="true"></div>
      <p class="masthead__issue label">
        <span>Vol. 01 / Issue 01</span><span>October 2026</span><span>{total} {total === 1 ? 'read' : 'reads'}, all free</span><span>No sign-up needed</span>
      </p>
      <h1 class="masthead__h1">
        <span class="masthead__title">The Journal</span>
        <span class="masthead__sub">Resources: guides, explainers and toolkits for the Fourth Wave</span>
      </h1>
      <div class="masthead__foot">
        <p class="masthead__lead">Plain words on feminism, from what the Fourth Wave is to how to stay safe online. Short enough for the bus, sourced enough for the debate. <strong>Hope first. Receipts always.</strong></p>
        <Placard text="Free to read. Free to share." shape="sticker" color="marigold" tilt={4} size="s" decorative />
      </div>
    </div>
    <ul class="strip wrap" role="list" aria-label="Pictures from this issue">
      {STRIP.map((p) => (
        <li><Photo id={p.id} tone={p.tone} aspect="4 / 5" caption={false} alt="" tilt={p.tilt} frame widths={[240, 360, 480]} sizes="(min-width: 900px) 220px, 40vw" /></li>
      ))}
    </ul>
  </header>

  <!-- 02 cover story + contents -->
  <section class="section cover-sec" aria-labelledby="cover-title">
    <div class="wrap cover-grid">
      {cover && (
        <article class="cover ground-red grain">
          {cover.data.heroPhoto && (
            <div class="cover__photo">
              <Photo id={cover.data.heroPhoto} tone="ink" aspect="4 / 5" caption={false} priority sizes="(min-width: 960px) 30vw, 92vw" widths={[420, 640, 900]} />
            </div>
          )}
          <div class="cover__body">
            <p class="label cover__kicker"><span>Cover story</span><span>{cover.data.kind}</span><span>{readingMinutes(cover)} min</span></p>
            <h2 class="cover__title" id="cover-title"><a href={`/resources/${cover.id}/`}>{coverMain}{coverTail && <span class="cover__tail"> {coverTail}</span>}</a></h2>
            <p class="cover__dek">{cover.data.description}</p>
            <ul class="cover__tldr" role="list">
              {cover.data.tldr.slice(0, 3).map((t) => <li>{t}</li>)}
            </ul>
            <p class="cover__cta" aria-hidden="true">Start here <span>→</span></p>
          </div>
          <span class="cover__placard" aria-hidden="true"><Placard text="Start here" shape="round" color="marigold" tilt={10} size="s" decorative /></span>
        </article>
      )}

      <nav class="contents" aria-labelledby="contents-title">
        <div class="contents__head">
          <h2 class="contents__title" id="contents-title">In this issue</h2>
          <Stamp text="Sourced" sub="Every number" tilt={-7} />
        </div>
        <ol class="contents__list" role="list">
          {articles.map((a, i) => (
            <li>
              <a href={`/resources/${a.id}/`}>
                <span class="contents__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="contents__kind label">{a.data.kind}</span>
                <span class="contents__t">{a.data.title}</span>
                <span class="contents__min label">{readingMinutes(a)} min</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/resources/glossary/">
              <span class="contents__n" aria-hidden="true">A–Z</span>
              <span class="contents__kind label">Glossary</span>
              <span class="contents__t">The feminist glossary: {glossary.length} terms in plain words</span>
              <span class="contents__min label">Look up</span>
            </a>
          </li>
        </ol>
      </nav>
    </div>
  </section>

  <Ticker items={['Hope first', 'Receipts always', 'Start where you are', 'Send it to the group chat']} tone="ink" />

  <!-- 03 find your read: CSS-only filters -->
  <section class="section find" id="find" aria-labelledby="find-title">
    <div class="wrap">
      <SectionHead num="01" label="Find your read" id="find-title" lead="Pick a type, pick who you are, or both. Everything is free to read and nothing asks for your data.">Every guide, <span class="red">one shelf</span></SectionHead>

      <div class="filters">
        <fieldset class="filter">
          <legend class="label">What kind of read?</legend>
          <div class="filter__opts">
            <input type="radio" name="kind" id="k-all" value="all" checked /><label for="k-all">All types</label>
            {kinds.map((k) => (<><input type="radio" name="kind" id={`k-${kindSlug(k)}`} value={kindSlug(k)} /><label for={`k-${kindSlug(k)}`}>{KIND_PLURAL[k] ?? k}</label></>))}
          </div>
        </fieldset>
        <fieldset class="filter">
          <legend class="label">Who's reading?</legend>
          <div class="filter__opts">
            <input type="radio" name="aud" id="a-all" value="all" checked /><label for="a-all">Everyone</label>
            {AUDIENCES.map((a) => (<><input type="radio" name="aud" id={`a-${a.key}`} value={a.key} /><label for={`a-${a.key}`}>{a.label}</label></>))}
          </div>
        </fieldset>
      </div>

      <div class="find__results">
        <ul class="find__grid" role="list">
          {articles.map((a) => (
            <li class="entry" data-kind={kindSlug(a.data.kind)} data-aud={audienceKeys(a.data.audience).join(' ')}>
              <Card href={`/resources/${a.id}/`} title={a.data.title} kicker={a.data.kind} meta={[`${readingMinutes(a)} min`]} dek={a.data.description} photo={a.data.heroPhoto} tone={a.data.tone} aspect="3 / 2" />
            </li>
          ))}
        </ul>
        <p class="find__count label" aria-hidden="true">Showing <span class="find__num"></span> of {total}</p>
        <p class="find__empty">Nothing in that mix yet: we're writing it. Try another filter, or read <a href={`/resources/${PILLAR_ID}/`}>the plain-language guide to the Fourth Wave</a>.</p>
      </div>
      <p class="find__teen small"><strong>Under 18?</strong> Everything in the Journal is free to read, with no sign-up and no tracking. Joining comes later, with a parent's OK.</p>
    </div>
  </section>

  <!-- 04 glossary teaser -->
  {teaser.length > 0 && (
    <section class="section gloss ground-pink grain" aria-labelledby="gloss-title">
      <div class="wrap gloss__inner">
        <SectionHead num="02" label="Say it plainly" id="gloss-title" lead="Jargon keeps people out. Here are the words you'll meet most, explained like a friend would.">The glossary</SectionHead>
        <ul class="gloss__grid" role="list">
          {teaser.map((g, i) => (
            <li class="gloss__card" style={`--r:${[-1.2, .8, -.5, 1.1, -.9, .6][i]}deg`}>
              <p class="gloss__term">{g.data.term}</p>
              {g.data.hindi && <p class="gloss__hi" lang="hi">{g.data.hindi}</p>}
              <p class="gloss__def">{g.data.definition}</p>
              <a class="gloss__link" href={`/resources/glossary/#${g.id}`}>{g.data.term} in the glossary<span class="visually-hidden">: definition, example and source</span> <span aria-hidden="true">→</span></a>
            </li>
          ))}
        </ul>
        <a class="btn btn--ink" href="/resources/glossary/">All {glossary.length} terms, A to Z <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  <!-- 05 go deeper -->
  <section class="section deeper" aria-labelledby="deeper-title">
    <div class="wrap">
      <SectionHead num="03" label="Go deeper" id="deeper-title" lead="Guides tell you what. These two tell you how we got here, and what worked elsewhere.">Nobody starts <span class="red">from zero</span></SectionHead>
      <div class="deeper__grid">
        <article class="door">
          <Photo id="in-015-2020-delhi-shaheen-bagh-fatima-sheikh-savitribai-phul" tone="green" aspect="16 / 10" caption={false} sizes="(min-width: 900px) 44vw, 92vw" widths={[480, 720, 960]} alt="A bus stop turned into a small library at a 2020 Delhi sit-in, hung with hand-painted posters." />
          <div class="door__body">
            <p class="label door__kicker">Public memory</p>
            <h3 class="door__title"><a href="/memory/">The struggles that brought us here</a></h3>
            <p>A sourced timeline of feminist history, India first: from the Phules' school in 1848 to the women's reservation law that is in force but still waiting to start.</p>
            <p class="door__pic small">Pictured: a temporary library named after Fatima Sheikh and Savitribai Phule at the Shaheen Bagh protest, New Delhi, 28 Jan 2020.</p>
          </div>
        </article>
        <article class="door">
          <Photo id="2018-dublin-castle-repeal-result-a" tone="marigold" aspect="16 / 10" caption={false} sizes="(min-width: 900px) 44vw, 92vw" widths={[480, 720, 960]} alt="A crowd celebrating in a courtyard after a referendum result is announced." />
          <div class="door__body">
            <p class="label door__kicker">Case studies</p>
            <h3 class="door__title"><a href="/case-studies/">What movements teach us</a></h3>
            <p>Fifteen campaigns, from Delhi 2012 and Bhanwari Devi's fight for the Vishaka rules to Iceland's strikes and Ni Una Menos. How they did it, what changed, what didn't.</p>
            <p class="door__pic small">Pictured: crowds at Dublin Castle as Ireland's Repeal the 8th result is announced, May 2018.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 06 newsletter -->
  <TornEdge color="var(--ink)" seed={2} />
  <section class="section news ground-ink grain">
    <div class="wrap news__inner">
      <div class="news__text">
        <p class="label news__label">The Journal, by email</p>
        <h2 class="h2" id="news-title">One email a month. <span class="red">No doom.</span></h2>
        <p class="lead">New guides, one good-news story, one receipt worth sending to the group chat. Unsubscribe in one click.</p>
        <p class="news__hand hand" aria-hidden="true">we never sell or share your email</p>
      </div>
      <div class="news__form">
        <NewsletterForm id="resources" />
      </div>
    </div>
  </section>

  <JoinBand ground="red" title="Read it. Share it. Then bring a friend." text="Every guide here is free. When you're ready to do more than read, joining takes a minute. Yes, boys too." />
</Base>

<style>
  /* Photo.astro: make <picture> fill fixed-aspect frames (see report: shared component). */
  :global(.photo--fixed .photo__img > picture) { display: block; height: 100%; }
  /* JoinBand: ground link colours override .btn text (see report); keep the button's own colours. */
  :global(.join-band .btn) { color: var(--btn-fg); }

  /* ---------- masthead ---------- */
  .masthead { background: var(--paper); padding-block: 18px 0; border-bottom: var(--rule); overflow: hidden; }
  .masthead > .wrap { position: relative; z-index: 2; }
  .crumbs-mini { display: flex; gap: .6em; }
  .crumbs-mini a { color: inherit; text-decoration: none; border-bottom: 1.5px solid currentColor; }
  .crumbs-mini [aria-current] { opacity: .75; }
  .masthead__rule { height: 9px; margin-top: 16px; border-top: 4px solid var(--ink); border-bottom: 1.5px solid var(--ink); }
  .masthead__issue { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 18px; padding: 8px 0; border-bottom: 1.5px solid var(--ink); }
  .masthead__h1 { display: grid; gap: 12px; margin-top: clamp(10px, 2vw, 18px); }
  .masthead__title {
    display: block; font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; line-height: .8; white-space: nowrap;
    font-size: clamp(3.6rem, 17.6vw, 17rem); letter-spacing: -.02em; margin-left: -.04em; color: var(--ink);
  }
  .masthead__sub { font-family: var(--font-serif); font-style: italic; font-weight: 500; font-size: clamp(1.3rem, 2.6vw, 2.1rem); line-height: 1.15; letter-spacing: -.01em; color: var(--red-ink); max-width: 30ch; }
  .masthead__foot { display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: center; justify-content: space-between; padding-block: 18px 6px; border-top: 1.5px solid var(--ink); margin-top: 18px; }
  .masthead__lead { max-width: 58ch; font-size: var(--fs-lead); line-height: 1.45; color: var(--ink-soft); }
  .masthead__lead strong { color: var(--ink); }

  .strip { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(10px, 2vw, 26px); padding-block: 26px 40px; }
  .strip li:nth-child(even) { margin-top: 22px; }
  @media (max-width: 700px) {
    .strip { grid-template-columns: repeat(3, minmax(0, 1fr)); padding-bottom: 30px; }
    .strip li:nth-child(n + 4) { display: none; }
    .strip li:nth-child(even) { margin-top: 14px; }
  }

  /* SectionHead numbers: protest red fails AA at label size, so use red-ink (ink on pink). */
  .find :global(.section-head__num), .deeper :global(.section-head__num) { color: var(--red-ink); }
  .gloss :global(.section-head__num) { color: var(--ink); }

  /* ---------- cover + contents ---------- */
  .cover-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 56px); align-items: start; }
  .cover { position: relative; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 0; box-shadow: 8px 8px 0 var(--ink); border: 3px solid var(--ink); }
  .cover__photo { position: relative; z-index: 2; }
  .cover__photo :global(.photo), .cover__photo :global(.photo__img) { height: 100%; width: 100%; }
  .cover__photo :global(.photo__img) { aspect-ratio: auto; min-height: 320px; }
  .cover__body { position: relative; z-index: 2; display: grid; gap: 16px; align-content: start; padding: clamp(20px, 3vw, 32px); }
  .cover__kicker { display: flex; flex-wrap: wrap; gap: .4em .9em; }
  .cover__kicker span:first-child { background: var(--paper-light); color: var(--red-ink); padding: .2em .45em; }
  .cover__title { font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(2.2rem, 3.6vw, 3.6rem); line-height: .88; text-wrap: balance; }
  .cover__title a { color: var(--paper-light); text-decoration: none; }
  .cover__title a::after { content: ''; position: absolute; inset: 0; z-index: 5; }
  .cover:has(a:focus-visible) { outline: 3px solid var(--ink); outline-offset: 6px; }
  .cover__title a:focus-visible { outline: none; box-shadow: none; }
  .cover:hover .cover__title a { text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: var(--marigold); }
  .cover__tail { display: block; margin-top: .3em; font-family: var(--font-serif); font-style: italic; font-weight: 500; text-transform: none; font-size: .55em; line-height: 1.1; color: var(--paper-light); }
  .cover__dek { font-family: var(--font-serif); font-size: 1.12rem; line-height: 1.45; color: var(--ink-soft); }
  .cover__tldr { display: grid; gap: 8px; border-top: 1.5px dashed var(--paper-light); padding-top: 14px; }
  .cover__tldr li { position: relative; padding-left: 1.4em; font-size: .96rem; line-height: 1.4; font-weight: 600; }
  .cover__tldr li::before { content: '✶'; position: absolute; left: 0; top: 0; color: var(--marigold); }
  .cover__cta { font-weight: 900; font-stretch: 80%; text-transform: uppercase; letter-spacing: .05em; border-bottom: 3px solid var(--marigold); justify-self: start; padding-bottom: 2px; }
  .cover__placard { position: absolute; top: -26px; left: -22px; z-index: 6; pointer-events: none; }

  .contents { border-top: var(--rule); }
  .contents__head { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 14px 12px; border-bottom: 1.5px solid var(--ink); }
  .contents__title { font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: .9; }
  .contents__list li { border-bottom: 1px solid var(--line-soft); }
  .contents__list a {
    display: grid; grid-template-columns: 2.6rem 6.4rem 1fr auto; gap: 4px 12px; align-items: baseline; padding: 11px 0; min-height: 44px;
    color: var(--ink); text-decoration: none;
  }
  .contents__list a:hover .contents__t { color: var(--red-ink); text-decoration: underline; text-decoration-thickness: 2px; }
  .contents__n { font-weight: 900; font-stretch: var(--display-stretch); font-size: 1.35rem; line-height: 1; color: var(--red-ink); }
  .contents__kind { color: var(--muted); font-size: .68rem; }
  .contents__t { font-weight: 750; line-height: 1.3; }
  .contents__min { color: var(--muted); white-space: nowrap; }
  @media (max-width: 960px) {
    .cover-grid { grid-template-columns: 1fr; }
    .cover__placard { left: auto; right: 6px; top: -30px; }
  }
  @media (max-width: 600px) {
    .cover { grid-template-columns: 1fr; }
    .cover__photo :global(.photo__img) { aspect-ratio: 16 / 10; min-height: 0; }
    .contents__list a { grid-template-columns: 2.4rem 1fr auto; }
    .contents__kind { grid-column: 2; grid-row: 1; }
    .contents__t { grid-column: 2 / -1; grid-row: 2; }
    .contents__min { grid-column: 3; grid-row: 1; }
  }

  /* ---------- filters (radio + :has, no JS) ---------- */
  .filters { display: grid; gap: 18px; margin-bottom: 28px; padding: 18px 0 20px; border-block: var(--rule); }
  .filter { border: 0; padding: 0; min-width: 0; }
  .filter legend { margin-bottom: 10px; float: left; width: 100%; }
  .filter__opts { clear: both; display: flex; flex-wrap: wrap; gap: 8px; }
  .filter input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .filter label {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border: 2px solid var(--ink); background: var(--paper-light);
    font-weight: 750; font-size: .95rem; cursor: pointer; user-select: none; transition: transform .12s var(--ease), box-shadow .12s var(--ease);
  }
  .filter label:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--ink); }
  .filter input:checked + label { background: var(--ink); color: var(--paper); box-shadow: 3px 3px 0 var(--red); }
  .filter input:focus-visible + label { outline: 3px solid var(--ink); outline-offset: 3px; box-shadow: 0 0 0 6px var(--marigold); }

  .find__results { display: flex; flex-direction: column; counter-reset: shown; }
  .find__count { order: -1; margin-bottom: 18px; color: var(--muted); }
  .find__num::before { content: counter(shown); color: var(--red-ink); font-weight: 900; }
  .find__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 3.4vw, 44px) clamp(20px, 3vw, 36px); }
  .entry { counter-increment: shown; }
  .find__empty { display: none; padding: 22px; border: 2px dashed var(--ink); background: var(--paper-light); font-weight: 600; }
  .find__teen { margin-top: 32px; padding-top: 14px; border-top: 1px solid var(--line-soft); max-width: 70ch; color: var(--ink-soft); }
  @media (max-width: 900px) { .find__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .find__grid { grid-template-columns: 1fr; } }

  .find:has(#k-guide:checked) .entry:not([data-kind='guide']),
  .find:has(#k-explainer:checked) .entry:not([data-kind='explainer']),
  .find:has(#k-toolkit:checked) .entry:not([data-kind='toolkit']),
  .find:has(#k-data:checked) .entry:not([data-kind='data']),
  .find:has(#k-history:checked) .entry:not([data-kind='history']),
  .find:has(#k-essay:checked) .entry:not([data-kind='essay']),
  .find:has(#k-reading-list:checked) .entry:not([data-kind='reading-list']),
