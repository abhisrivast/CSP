---
// Wayfinding strip across the four trust documents (privacy, safeguarding, accessibility, credits).
export type TrustDoc = 'privacy' | 'safeguarding' | 'accessibility' | 'credits';
export interface Props { current: TrustDoc }
const { current } = Astro.props;
const DOCS: { key: TrustDoc; label: string; href: string; hint: string }[] = [
  { key: 'privacy', label: 'Privacy', href: '/privacy/', hint: 'Your data' },
  { key: 'safeguarding', label: 'Safeguarding', href: '/safeguarding/', hint: 'Keeping people safe' },
  { key: 'accessibility', label: 'Accessibility', href: '/accessibility/', hint: 'Using this site' },
  { key: 'credits', label: 'Image credits', href: '/credits/', hint: 'Every photo' },
];
---
<nav class="tnav" aria-label="Trust documents">
  <p class="label tnav__title">Trust documents</p>
  <ol class="tnav__list" role="list">
    {DOCS.map((d, i) => (
      <li>
        <a href={d.href} aria-current={d.key === current ? 'page' : undefined}>
          <span class="tnav__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="tnav__label">{d.label}</span>
          <span class="tnav__hint">{d.hint}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .tnav { display: grid; grid-template-columns: auto 1fr; align-items: stretch; gap: 0 24px; border-top: 3px solid var(--ink); }
  .tnav__title { padding-top: 14px; color: var(--ink-soft); }
  .tnav__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .tnav__list li + li { border-left: 1px solid var(--line-soft); }
  .tnav a {
    display: grid; grid-template-columns: auto 1fr; gap: 0 10px; align-content: start; min-height: 64px; height: 100%;
    padding: 12px 16px 14px; color: var(--ink); text-decoration: none; position: relative;
  }
  .tnav__n { grid-row: span 2; font-weight: 900; font-stretch: var(--display-stretch); font-size: 1.6rem; line-height: .9; color: var(--red); }
  .tnav__label { font-weight: 800; font-stretch: var(--head-stretch); font-size: 1.05rem; line-height: 1.1; }
  .tnav__hint { font-size: .8rem; color: var(--muted); line-height: 1.3; }
  .tnav a:hover .tnav__label { color: var(--red-ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .18em; }
  .tnav a[aria-current='page'] { background: var(--ink); color: var(--paper-light); }
  .tnav a[aria-current='page'] .tnav__n { color: var(--marigold); }
  .tnav a[aria-current='page'] .tnav__hint { color: #CFC6B4; }
  .tnav a[aria-current='page']:hover .tnav__label { color: var(--paper-light); }
  @media (max-width: 860px) {
    .tnav { grid-template-columns: 1fr; }
    .tnav__title { padding-block: 12px 8px; }
    .tnav__list { grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line-soft); }
    .tnav__list li:nth-child(3) { border-left: 0; }
    .tnav__list li:nth-child(n+3) { border-top: 1px solid var(--line-soft); }
    .tnav a { padding: 10px 12px 12px; }
    .tnav__hint { display: none; }
    .tnav__n { grid-row: auto; font-size: 1.3rem; }
    .tnav a { align-items: center; }
  }
</style>
