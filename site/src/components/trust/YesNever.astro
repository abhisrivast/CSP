---
// Two-column board: what you can do / what we will never do. Marks are text, not colour alone.
export interface Props {
  yesTitle: string;
  neverTitle: string;
  yes: string[];
  never: string[];
  id?: string;
}
const { yesTitle, neverTitle, yes, never, id = 'yn' } = Astro.props;
---
<div class="yn">
  <section class="yn__col yn__col--yes" aria-labelledby={`${id}-yes`}>
    <h3 class="yn__title" id={`${id}-yes`}><span class="yn__mark" aria-hidden="true">✓</span>{yesTitle}</h3>
    <ul role="list">{yes.map((t) => <li><span class="yn__tick" aria-hidden="true">✓</span><span>{t}</span></li>)}</ul>
  </section>
  <section class="yn__col yn__col--never" aria-labelledby={`${id}-never`}>
    <h3 class="yn__title" id={`${id}-never`}><span class="yn__mark" aria-hidden="true">✕</span>{neverTitle}</h3>
    <ul role="list">{never.map((t) => <li><span class="yn__tick" aria-hidden="true">✕</span><span>{t}</span></li>)}</ul>
  </section>
</div>

<style>
  .yn { display: grid; grid-template-columns: 1fr 1fr; border: 2px solid var(--ink); font-family: var(--font-sans); }
  .yn__col { padding: clamp(18px, 2.6vw, 28px); display: grid; gap: 14px; align-content: start; }
  .yn__col--yes { background: var(--paper-light); }
  .yn__col--never { background: var(--ink); color: var(--paper); }
  .yn__title { display: flex; align-items: center; gap: 12px; font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(1.7rem, 2.6vw, 2.2rem); line-height: .9; margin: 0 !important; }
  .yn__mark { display: inline-grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; font-size: 1.2rem; font-stretch: 100%; }
  .yn__col--yes .yn__mark { background: var(--green); color: var(--paper); }
  .yn__col--never .yn__mark { background: var(--coral); color: var(--ink); }
  .yn ul { display: grid; gap: 0; }
  .yn li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; padding: 10px 0; border-top: 1px solid var(--line-soft); font-size: 1rem; line-height: 1.45; }
  .yn__col--never li { border-top-color: #5A554D; }
  .yn__tick { font-weight: 900; }
  .yn__col--yes .yn__tick { color: var(--green); }
  .yn__col--never .yn__tick { color: var(--coral); }
  @media (max-width: 700px) { .yn { grid-template-columns: 1fr; } }
</style>
