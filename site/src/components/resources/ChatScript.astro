---
// A "what to say" script styled as a group chat. Illustrative conversations, never real people.
// Usage: <ChatScript chat="Boys of 11-B" situation="A friend shares a clip…" lines={[{ from: 'them', text: '…' }, { from: 'you', text: '…' }]} why="…" />
export type Line = { from: 'them' | 'you'; text: string; name?: string };
export interface Props { chat: string; situation: string; lines: Line[]; why?: string; n?: string }
const { chat, situation, lines, why, n } = Astro.props;
---
<figure class="r-wide chat">
  <div class="chat__phone">
    <p class="chat__bar"><span class="chat__dot" aria-hidden="true"></span><span class="chat__name">{chat}</span><span class="chat__ill label">Example</span></p>
    <ol class="chat__msgs" role="list">
      {lines.map((l) => (
        <li class:list={['msg', `msg--${l.from}`]}>
          <span class="msg__who">{l.from === 'you' ? 'You could say' : (l.name ?? 'Your friend')}<span class="visually-hidden">:</span></span>
          <span class="msg__text">{l.text}</span>
        </li>
      ))}
    </ol>
  </div>
  <figcaption class="chat__cap">
    {n && <span class="chat__n" aria-hidden="true">{n}</span>}
    <span class="label chat__k">The situation</span>
    <span class="chat__sit">{situation}</span>
    {why && <><span class="label chat__k">Why it works</span><span class="chat__why">{why}</span></>}
  </figcaption>
</figure>

<style>
  .chat { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 22px clamp(20px, 4vw, 44px); align-items: start; margin-block: 2.2em; font-family: var(--font-sans); }
  .chat__phone { background: var(--paper-light); border: 3px solid var(--ink); border-radius: 22px; overflow: hidden; box-shadow: 6px 6px 0 var(--ink); }
  .chat__bar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--green); color: var(--paper); font-weight: 800; }
  .chat__dot { width: 30px; height: 30px; border-radius: 50%; background: var(--marigold); border: 2px solid var(--paper); flex: none; }
  .chat__name { flex: 1; line-height: 1.2; }
  .chat__ill { color: var(--marigold); }
  .chat__msgs { list-style: none; display: grid; gap: 10px; padding: 16px 14px 18px !important; margin: 0 !important; background: var(--paper-deep); background-image: radial-gradient(rgba(29, 28, 24, .07) 1px, transparent 1px); background-size: 14px 14px; }
  .chat__msgs li + li { margin-top: 0 !important; }
  .msg { display: grid; gap: 3px; max-width: 86%; padding: 9px 12px 10px; border-radius: 14px; font-size: .98rem; line-height: 1.42; }
  .msg__who { font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .msg--them { justify-self: start; background: var(--paper-light); border: 1.5px solid var(--line-soft); border-top-left-radius: 4px; }
  .msg--them .msg__who { color: var(--muted); }
  .msg--you { justify-self: end; background: var(--red-ink); color: var(--paper-light); border-top-right-radius: 4px; }
  .msg--you .msg__who { color: #FBE7E1; }
  .chat__cap { display: grid; gap: 6px; align-content: start; padding-top: 6px; }
  .chat__n { font-weight: 900; font-stretch: var(--display-stretch); font-size: 3.6rem; line-height: .8; color: var(--red); margin-bottom: 6px; }
  .chat__k { color: var(--muted); margin-top: 8px; }
  .chat__sit { font-weight: 700; font-size: 1.05rem; line-height: 1.4; }
  .chat__why { font-family: var(--font-serif); font-size: 1.05rem; line-height: 1.5; color: var(--ink-soft); }
  @media (max-width: 760px) { .chat { grid-template-columns: 1fr; } .chat__cap { order: -1; } .chat__n { font-size: 2.6rem; } }
</style>
