---
// India helpline block (docs/STRATEGY.md §13): use exactly, with the check-before-you-call date and source.
export interface Props { title?: string; checked?: string }
const { title = 'Need help now?', checked = '24 October 2026' } = Astro.props;
const LINES = [
  { n: '112', what: 'Emergency' },
  { n: '181', what: 'National Women Helpline' },
  { n: '14490', what: 'NCW 24×7 Women Helpline (women over 18)' },
  { n: '1930', what: 'Cyber crime, and cybercrime.gov.in' },
  { n: '1098', what: 'Child Helpline' },
  { n: '14416', what: 'Tele-MANAS mental health' },
];
---
<aside class="r-wide help" aria-labelledby="help-title">
  <h2 class="help__title" id="help-title">{title}</h2>
  <p class="help__lead">If you or someone you know is in danger, or just needs to talk to someone, these numbers are free in India.</p>
  <ul class="help__list" role="list">
    {LINES.map((l) => (
      <li><a href={`tel:${l.n}`}><span class="help__n">{l.n}</span><span class="help__what">{l.what}</span></a></li>
    ))}
  </ul>
  <p class="help__note small">Numbers checked {checked}; check before you call. Source: <a href="https://www.ncw.gov.in/other-useful-helplines/" rel="noopener">National Commission for Women, other useful helplines</a>. Report cyber crime at <a href="https://cybercrime.gov.in/" rel="noopener">cybercrime.gov.in</a>. This is information, not legal or medical advice.</p>
</aside>

<style>
  .help { margin-block: 2.4em; padding: clamp(20px, 3vw, 30px); background: var(--ink); color: var(--paper); font-family: var(--font-sans); border-left: 10px solid var(--marigold); }
  .help__title { font-family: var(--font-sans); font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(1.9rem, 3.4vw, 2.6rem) !important; line-height: .9; margin: 0 !important; padding: 0 !important; border: 0 !important; color: var(--paper); }
  .help__lead { margin-top: 10px; color: #CFC6B4; max-width: 56ch; }
  .help__list { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 18px 0 0 !important; padding: 0 !important; }
  .help__list li + li { margin-top: 0 !important; }
  .help__list a { display: grid; gap: 2px; min-height: 64px; padding: 10px 12px; border: 1.5px solid #5A554D; color: var(--paper); text-decoration: none; }
  .help__list a:hover { border-color: var(--marigold); }
  .help__n { font-weight: 900; font-stretch: var(--display-stretch); font-size: 2rem; line-height: .9; color: var(--marigold); }
  .help__what { font-size: .86rem; line-height: 1.3; }
  .help__note { margin-top: 16px; color: #CFC6B4; }
  .help__note a { color: var(--coral); }
  @media (max-width: 700px) { .help__list { grid-template-columns: 1fr 1fr; } }
</style>
