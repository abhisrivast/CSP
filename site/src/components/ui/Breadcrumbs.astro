---
// Visible breadcrumbs (JSON-LD is emitted separately by <Head breadcrumbs>).
export interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs label" aria-label="Breadcrumb">
  <ol role="list">
    <li><a href="/">Home</a></li>
    {items.map((it, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{it.name}</span> : <a href={it.href}>{it.name}</a>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: .3em .7em; padding: 0; list-style: none; }
  .crumbs li + li::before { content: '/'; margin-right: .7em; opacity: .5; }
  .crumbs a { color: inherit; text-decoration: none; border-bottom: 1.5px solid currentColor; }
  .crumbs a:hover { color: var(--red-ink); }
  /* Grow the tiny label-size links to a ≥44px touch target without moving anything. */
  .crumbs a { position: relative; }
  .crumbs a::before { content: ''; position: absolute; inset: -16px -6px; }
  .crumbs [aria-current] { opacity: .75; }
</style>
