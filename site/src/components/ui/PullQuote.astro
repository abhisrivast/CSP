---
export interface Props { quote?: string; by?: string; role?: string; href?: string; size?: 'm' | 'l' }
const { quote, by, role, href, size = 'm' } = Astro.props;
---
<figure class:list={['pull', `pull--${size}`]}>
  <blockquote class="serif-display"><p>{quote}<slot /></p></blockquote>
  {by && (
    <figcaption class="label">
      <span aria-hidden="true">— </span>{href ? <a href={href} rel="noopener">{by}</a> : by}{role && <span class="pull__role">, {role}</span>}
    </figcaption>
  )}
</figure>

<style>
  .pull { position: relative; padding-top: clamp(40px, 6vw, 70px); }
  blockquote { max-width: 20em; }
  .pull--l blockquote { max-width: 15em; }
  .pull::before {
    content: '“'; position: absolute; top: -0.12em; left: -0.06em; font-family: var(--font-serif); font-weight: 700;
    font-size: clamp(7rem, 14vw, 11rem); line-height: 1; color: var(--red);
  }
  blockquote { font-style: italic; font-size: clamp(1.7rem, 3.6vw, 2.8rem); line-height: 1.12; }
  .pull--l blockquote { font-size: clamp(2.1rem, 5vw, 4rem); }
  figcaption { margin-top: 18px; }
  .pull__role { font-weight: 500; text-transform: none; letter-spacing: 0; }
  :global(.ground-ink) .pull::before, :global(.ground-green) .pull::before { color: var(--coral); }
</style>
