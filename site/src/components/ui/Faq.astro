---
// Answer-first FAQ item. The first paragraph must answer the question in 1–2 sentences (answer engines quote it).
export interface Props { q: string; id?: string; open?: boolean }
const { q, id, open = false } = Astro.props;
---
<details class="faq" id={id} open={open}>
  <summary><h3 class="faq__q">{q}</h3><span class="faq__icon" aria-hidden="true"></span></summary>
  <div class="faq__a"><slot /></div>
</details>

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq:last-of-type { border-bottom: 1px solid var(--line); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .faq__q { font-size: clamp(1.15rem, 2vw, 1.4rem); font-weight: 800; font-stretch: var(--head-stretch); line-height: 1.15; }
  summary:hover .faq__q { color: var(--red-ink); }
  .faq__icon { position: relative; flex: none; width: 34px; height: 34px; border: 2px solid var(--ink); border-radius: 50%; }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 3px; background: var(--ink); transform: translate(-50%, -50%); transition: transform .2s var(--ease); }
  .faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq[open] .faq__icon { background: var(--ink); }
  .faq[open] .faq__icon::before, .faq[open] .faq__icon::after { background: var(--paper); }
  .faq[open] .faq__icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq__a { padding: 0 0 24px; max-width: 70ch; display: grid; gap: .8em; color: var(--ink-soft); }
  .faq__a :global(p:first-child) { color: var(--text); font-weight: 600; font-size: 1.08rem; }
</style>
