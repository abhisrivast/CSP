---
// A "receipt": one hard number + what it means + its source and date. Every stat on the site uses this.
export interface Props {
  figure: string;          // "1 in 3", "13.6%", "74"
  label: string;           // what the number counts
  source: string;          // publisher + report
  href: string;            // primary source URL
  date: string;            // year or month of the data
  note?: string;           // short context line
  tone?: 'paper' | 'red' | 'ink' | 'pink' | 'marigold';
  tilt?: number;
}
const { figure, label, source, href, date, note, tone = 'paper', tilt = 0 } = Astro.props;
---
<article class:list={['receipt', `receipt--${tone}`]} style={tilt ? `--tilt:${tilt}deg` : undefined}>
  <p class="label receipt__head"><span>Receipt</span><span aria-hidden="true">✶</span><span>{date}</span></p>
  <p class="receipt__figure">{figure}</p>
  <p class="receipt__label">{label}</p>
  {note && <p class="receipt__note">{note}</p>}
  <p class="receipt__source"><span class="label">Source</span> <a href={href} rel="noopener" target="_blank">{source}<span class="visually-hidden"> (opens in a new tab)</span></a></p>
</article>

<style>
  .receipt {
    --bg: var(--paper-light); --fg: var(--ink); --accent: var(--red);
    position: relative; display: grid; gap: 10px; align-content: start; padding: 22px 22px 34px;
    background: var(--bg); color: var(--fg); transform: rotate(var(--tilt, 0deg));
    border-top: 6px solid var(--ink);
    /* torn till-roll bottom edge */
    -webkit-mask: linear-gradient(#000 0 0) top / 100% calc(100% - 10px) no-repeat, radial-gradient(circle 7px at 50% 100%, transparent 6px, #000 7px) bottom / 16px 11px repeat-x;
    mask: linear-gradient(#000 0 0) top / 100% calc(100% - 10px) no-repeat, radial-gradient(circle 7px at 50% 100%, transparent 6px, #000 7px) bottom / 16px 11px repeat-x;
    filter: drop-shadow(3px 4px 0 rgba(29, 28, 24, .14));
  }
  .receipt__head { display: flex; justify-content: space-between; border-bottom: 1.5px dashed currentColor; padding-bottom: 8px; opacity: .85; }
  .receipt__figure { font-weight: 900; font-stretch: var(--display-stretch); font-size: clamp(3.4rem, 7vw, 5.4rem); line-height: .85; color: var(--accent); letter-spacing: -.01em; }
  .receipt__label { font-weight: 700; font-size: 1.08rem; line-height: 1.3; }
  .receipt__note { font-size: .92rem; color: inherit; opacity: .85; }
  .receipt__source { font-size: .82rem; line-height: 1.35; border-top: 1.5px dashed currentColor; padding-top: 10px; margin-top: 4px; }
  .receipt__source a { color: inherit; }
  .receipt--red { --bg: var(--red-ink); --fg: var(--paper-light); --accent: var(--paper-light); }
  .receipt--ink { --bg: var(--ink); --fg: var(--paper); --accent: var(--coral); }
  .receipt--pink { --bg: var(--pink); --accent: var(--ink); }
  .receipt--marigold { --bg: var(--marigold); --accent: var(--ink); }
</style>
