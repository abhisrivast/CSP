---
// "What we won't do": a stamped list of refusals, each struck through in protest red.
export type Refusal = { no: string; text: string };
export interface Props { items: Refusal[] }
const { items } = Astro.props;
---
<ol class="wont" role="list">
  {items.map((it, i) => (
    <li class="wont__item">
      <span class="wont__stamp" aria-hidden="true" style={`--tilt:${[-9, 6, -5, 8, -7][i % 5]}deg`}>No</span>
      <div class="wont__body">
        <h3 class="wont__title"><span class="visually-hidden">No </span><span class="wont__word">{it.no}</span></h3>
        <p class="wont__text">{it.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .wont { display: grid; gap: 0; border-top: 3px solid var(--line); }
  .wont__item { display: grid; grid-template-columns: 96px 1fr; gap: clamp(16px, 3vw, 36px); align-items: center; padding-block: clamp(18px, 2.6vw, 28px); border-bottom: 1px solid var(--line); }
  .wont__stamp {
    display: grid; place-items: center; width: 86px; height: 86px; border-radius: 50%;
    border: 4px solid var(--red-ink); outline: 2px solid var(--red-ink); outline-offset: 3px; color: var(--red-ink);
    font-weight: 900; font-stretch: 80%; text-transform: uppercase; letter-spacing: .08em; font-size: 1.5rem;
    transform: rotate(var(--tilt)); -webkit-mask: url('/textures/distress.png') center / 120px; mask: url('/textures/distress.png') center / 120px;
  }
  .wont__body { display: grid; gap: 8px; }
  .wont__title { font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(2rem, 4.6vw, 3.6rem); line-height: .9; }
  .wont__word { text-decoration: line-through; text-decoration-color: var(--red); text-decoration-thickness: .11em; text-decoration-skip-ink: none; }
  .wont__text { color: var(--ink-soft); max-width: 58ch; font-size: 1.02rem; line-height: 1.5; }
  @media (max-width: 560px) {
    .wont__item { grid-template-columns: 64px 1fr; align-items: start; }
    .wont__stamp { width: 60px; height: 60px; font-size: 1.05rem; border-width: 3px; }
  }
</style>
