---
// India helpline block (docs/STRATEGY.md §13), exactly as specified, with the check-before-you-call date and source.
export interface Props { id?: string; title?: string; lead?: string; level?: 'h2' | 'h3'; compact?: boolean }
const {
  id = 'help-now',
  title = 'Need help now?',
  lead = 'If you or someone you know is in danger, or just needs to talk to someone, these numbers are free in India.',
  level: H = 'h2',
  compact = false,
} = Astro.props;
const LINES = [
  { n: '112', what: 'Emergency: police, fire, ambulance' },
  { n: '181', what: 'National Women Helpline' },
  { n: '14490', what: 'NCW 24×7 Women Helpline (women over 18)' },
  { n: '1930', what: 'Cyber crime, and cybercrime.gov.in' },
  { n: '1098', what: 'Child Helpline' },
  { n: '14416', what: 'Tele-MANAS mental health' },
];
---
<aside class:list={['help', { 'help--compact': compact }]} aria-labelledby={`${id}-title`}>
  <H class="help__title" id={`${id}-title`}>{title}</H>
  <p class="help__lead">{lead}</p>
  <ul class="help__list" role="list">
    {LINES.map((l) => (
      <li><a href={`tel:${l.n}`}><span class="help__n">{l.n}</span><span class="help__what">{l.what}</span></a></li>
    ))}
  </ul>
  <p class="help__note">Numbers checked 24 October 2026; check before you call. Source: <a href="https://www.ncw.gov.in/other-useful-helplines/" rel="noopener">National Commission for Women, other useful helplines</a>. Report cyber crime at <a href="https://cybercrime.gov.in/" rel="noopener">cybercrime.gov.in</a>. This is information, not legal or medical advice.</p>
</aside>

<style>
  .help { display: grid; gap: 14px; padding: clamp(20px, 3vw, 32px); background: var(--ink); color: var(--paper); border-left: 10px solid var(--marigold); }
  .help__title { font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(2rem, 3.6vw, 2.9rem); line-height: .9; color: var(--paper); }
  .help__lead { color: #CFC6B4; max-width: 58ch; }
  .help__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .help__list a { display: grid; gap: 4px; min-height: 72px; padding: 12px 14px; border: 1.5px solid #6B655C; color: var(--paper); text-decoration: none; transition: border-color .15s var(--ease), background .15s var(--ease); }
  .help__list a:hover { border-color: var(--marigold); background: #26251F; color: var(--paper); }
  .help__n { font-weight: 900; font-stretch: var(--display-stretch); font-size: clamp(2.1rem, 3vw, 2.6rem); line-height: .85; color: var(--marigold); letter-spacing: .01em; }
  .help__what { font-size: .88rem; line-height: 1.3; }
  .help__note { font-size: .84rem; line-height: 1.45; color: #CFC6B4; }
  .help__note a { color: var(--coral); }
  .help__note a:hover { color: var(--paper); }
  .help--compact .help__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .help--compact .help__n { font-size: 2rem; }
  @media (max-width: 700px) { .help__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 360px) { .help__list { grid-template-columns: 1fr; } }
</style>
