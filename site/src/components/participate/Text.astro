---
// Plain text with every Devanagari run wrapped in <span lang="hi"> (WCAG 3.1.2), so content files can stay plain text.
export interface Props { text: string }
const { text } = Astro.props;
const parts = text.split(/([ऀ-ॿ][ऀ-ॿ\s]*[ऀ-ॿ]|[ऀ-ॿ])/u).filter((p) => p !== '');
const isHi = (p: string) => /[ऀ-ॿ]/u.test(p);
---
{parts.map((p) => (isHi(p) ? <span lang="hi">{p}</span> : p))}
