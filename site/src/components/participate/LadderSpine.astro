---
// The engagement ladder as the spine of /join/: five rungs that step out and darken as they ask more of you.
// Each rung carries 2–3 concrete actions with links, and one photo.
import Shot from './Shot.astro';
import type { Tone } from '../../lib/photos';

export type Action = { verb: string; label: string; href: string };
export type Rung = {
  id: string;
  where: string;
  time: string;
  roles: string;
  text: string;
  actions: Action[];
  photo: { id: string; tone: Tone; alt: string; position?: string; caption?: string };
};
export interface Props { rungs: Rung[] }
const { rungs } = Astro.props;
---
<ol class="spine" role="list">
  {rungs.map((r, i) => (
    <li class:list={['step', `step--${i + 1}`]} id={r.id} style={`--i:${i}`}>
      <div class="step__head">
        <p class="step__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
        <div class="step__titles">
          <h3 class="step__where"><span class="visually-hidden">Rung {i + 1} of {rungs.length}: </span>{r.where}</h3>
          <p class="step__meta label"><span class="step__time">{r.time}</span><span class="step__role">{r.roles}</span></p>
        </div>
        <p class="step__text">{r.text}</p>
      </div>
      <ul class="step__acts" role="list">
        {r.actions.map((a) => (
          <li>
            <a class="act" href={a.href}>
              <span class="act__verb label">{a.verb}</span>
              <span class="act__label">{a.label}</span>
              <span class="act__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="step__pic">
        <Shot id={r.photo.id} tone={r.photo.tone} aspect="4 / 5" position={r.photo.position} alt={r.photo.alt} caption={false}
          sizes="(min-width: 1000px) 15vw, (min-width: 640px) 26vw, 34vw" widths={[240, 360, 480]} />
        {r.photo.caption && <p class="step__cap">{r.photo.caption}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .spine { display: grid; gap: 0; position: relative; }
  .step {
    --bg: var(--paper-light); --fg: var(--ink); --soft: var(--ink-soft); --rule-c: var(--ink); --chip-bg: var(--ink); --chip-fg: var(--paper-light); --hover: var(--paper);
    position: relative; display: grid; grid-template-columns: minmax(0, 4.6fr) minmax(0, 5fr) minmax(150px, 2.2fr);
    gap: clamp(18px, 2.6vw, 36px); align-items: start;
    margin-left: calc(var(--i) * clamp(0px, 3.4vw, 52px));
    padding: clamp(22px, 2.8vw, 34px) clamp(20px, 2.6vw, 34px);
    background: var(--bg); color: var(--fg); border: 3px solid var(--ink);
  }
  .step + .step { margin-top: -3px; }
  .step--2 { --bg: var(--pink); --soft: #3E3A34; --hover: #F3C4BC; }
  .step--3 { --bg: var(--marigold); --soft: #3E3A34; --hover: #F5C687; }
  .step--4 { --bg: var(--red-ink); --fg: var(--paper-light); --soft: #FBE7E1; --rule-c: var(--paper-light); --chip-bg: var(--paper-light); --chip-fg: var(--red-ink); --hover: #9E2019; }
  .step--5 { --bg: var(--ink); --fg: var(--paper); --soft: #CFC6B4; --rule-c: var(--paper); --chip-bg: var(--marigold); --chip-fg: var(--ink); --hover: #2C2B25; }

  .step__head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px 16px; align-items: end; }
  .step__n { font-weight: 900; font-stretch: var(--display-stretch); font-size: clamp(4rem, 7vw, 6.6rem); line-height: .74; letter-spacing: -.03em; color: var(--red); }
  .step--3 .step__n, .step--2 .step__n { color: var(--red-ink); }
  .step--4 .step__n { color: var(--paper-light); }
  .step--5 .step__n { color: var(--coral); }
  .step__titles { display: grid; gap: 8px; }
  .step__where { font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(1.75rem, 2.9vw, 2.75rem); line-height: .88; text-wrap: balance; }
  .step__meta { display: flex; flex-wrap: wrap; gap: 6px; }
  .step__meta span { padding: .28em .5em .22em; border: 1.5px solid currentColor; }
  .step__time { background: var(--chip-bg); color: var(--chip-fg); border-color: var(--chip-bg) !important; }
  .step__text { grid-column: 1 / -1; color: var(--soft); font-size: 1.02rem; line-height: 1.45; max-width: 40ch; }

  .step__acts { display: grid; border-top: 2px solid var(--rule-c); }
  .act {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; gap: 2px 12px; align-items: center;
    min-height: 56px; padding: 12px 8px 12px 0; color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--rule-c);
    transition: background .15s var(--ease), padding .15s var(--ease);
  }
  .act:hover { background: var(--hover); padding-left: 8px; color: var(--fg); }
  .act__verb { grid-column: 1; opacity: .85; }
  .act__label { grid-column: 1; font-weight: 800; font-stretch: var(--head-stretch); font-size: clamp(1.08rem, 1.4vw, 1.26rem); line-height: 1.12; }
  .act__arrow { grid-column: 2; grid-row: 1 / 3; font-weight: 900; font-size: 1.3rem; transition: transform .15s var(--ease); }
  .act:hover .act__arrow { transform: translateX(4px); }
  .act:hover .act__label { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .18em; }
  .step--4 .act:focus-visible, .step--5 .act:focus-visible { outline-color: var(--paper-light); }

  .step__pic { position: relative; margin-top: -8px; transform: rotate(calc(2deg - var(--i) * 1deg)); }
  .step__pic :global(.photo__img) { border: 6px solid var(--paper-light); box-shadow: 4px 5px 0 rgba(29, 28, 24, .28); }
  .step__cap { margin-top: 8px; font-size: .74rem; line-height: 1.35; color: var(--soft); }

  @media (max-width: 1000px) {
    .step { grid-template-columns: minmax(0, 1fr) minmax(120px, 30%); margin-left: calc(var(--i) * 14px); }
    .step__head { grid-column: 1; }
    .step__pic { grid-column: 2; grid-row: 1 / 3; }
    .step__acts { grid-column: 1; }
  }
  @media (max-width: 640px) {
    .step { grid-template-columns: auto minmax(0, 1fr) 76px; gap: 12px 12px; margin-left: calc(var(--i) * 5px); padding: 20px 16px 16px; }
    .step__head { display: contents; }
    .step__n { grid-column: 1; grid-row: 1; align-self: start; font-size: 3.3rem; }
    .step__titles { grid-column: 2; grid-row: 1; align-self: start; }
    .step__pic { grid-column: 3; grid-row: 1; width: 76px; margin-top: 0; align-self: start; }
    .step__text { grid-column: 1 / -1; grid-row: 2; }
    .step__acts { grid-column: 1 / -1; grid-row: 3; }
    .step__where { font-size: 1.75rem; }
    .step__pic :global(.photo__img) { border-width: 4px; }
    .step__cap { display: none; }
  }
</style>
