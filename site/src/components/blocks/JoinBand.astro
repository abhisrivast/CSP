---
// Closing call to action used at the end of most pages. One primary CTA, one no-data alternative.
// Pass `next` to lead with a page-specific next step (the next case, the related guide) above the join ask,
// so the page ending is about this page, not a template.
import Placard from '../ui/Placard.astro';
type Link = { label: string; href: string };
export interface Props {
  title?: string;
  text?: string;
  primary?: Link;
  secondary?: Link;
  next?: Link & { kicker?: string; dek?: string };
  placard?: string;
  ground?: 'green' | 'red' | 'ink';
}
const here = Astro.url.pathname;
const {
  title = 'Bring a friend. Yes, boys too.',
  text = 'Joining is free and takes a minute. Start small: read, share, sign the manifesto. Go big when you are ready.',
  placard = 'The next wave is us',
  ground = 'green',
  next,
} = Astro.props;
// Never link a page to itself: on /join/ the band asks for the next rung instead, on /manifesto/ it points onward.
const swap = (l: Link, alt: Link) => (l.href.split('#')[0] === here ? alt : l);
const primary = swap(Astro.props.primary ?? { label: 'Join the movement', href: '/join/' }, { label: 'Sign the manifesto', href: '/manifesto/#sign' });
const secondary = swap(Astro.props.secondary ?? { label: 'Read the manifesto', href: '/manifesto/' }, { label: 'What we do', href: '/what-we-do/' });
const external = (href: string) => /^https?:\/\//.test(href);
---
<section class:list={['join-band', `ground-${ground}`, 'grain']}>
  <div class="wrap join-band__inner">
    <div class="join-band__text">
      {next && (
        <a class="join-band__next" href={next.href}>
          <span class="label">{next.kicker ?? 'Next'}</span>
          <span class="join-band__next-title">{next.label} <span class="arrow" aria-hidden="true">→</span></span>
          {next.dek && <span class="join-band__next-dek">{next.dek}</span>}
        </a>
      )}
      <h2 class="h2">{title}</h2>
      <p class="lead">{text}</p>
      <div class="join-band__ctas">
        <a class="btn btn--paper" href={primary.href}>{primary.label} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link-arrow" href={secondary.href} rel={external(secondary.href) ? 'noopener' : undefined}>{secondary.label} <span aria-hidden="true">{external(secondary.href) ? '↗' : '→'}</span></a>
      </div>
    </div>
    <div class="join-band__art" aria-hidden="true">
      <Placard text={placard} color="marigold" size="l" tilt={-6} stick decorative />
    </div>
  </div>
</section>

<style>
  .join-band { padding-block: clamp(3.5rem, 8vw, 6rem); position: relative; }
  .join-band__inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center; }
  .join-band__text { display: grid; gap: 22px; }
  .join-band__text .h2 { max-width: 14ch; }
  .join-band__ctas { display: flex; flex-wrap: wrap; gap: 18px 28px; align-items: center; }
  .join-band .link-arrow { color: var(--paper); border-color: var(--marigold); }
  .join-band .link-arrow:hover { color: var(--marigold); }
  .join-band .btn--paper, .join-band .btn--paper:hover { color: var(--ink); }
  .join-band__next {
    display: grid; gap: 6px; max-width: 46ch; margin-bottom: 10px; padding: 16px 18px 18px;
    background: var(--paper-light); color: var(--ink); text-decoration: none; border: 2px solid var(--ink); box-shadow: 5px 5px 0 var(--ink);
    transition: transform .15s var(--ease), box-shadow .15s var(--ease);
  }
  .join-band__next:hover { color: var(--ink); transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--ink); }
  .join-band__next .label { color: var(--red-ink); }
  .join-band__next-title { font-weight: 900; font-stretch: var(--head-stretch); font-size: clamp(1.3rem, 2.2vw, 1.7rem); line-height: 1.05; }
  .join-band__next-dek { color: #5A554D; font-size: .95rem; line-height: 1.4; }
  .join-band__art { display: grid; place-items: center; }
  .join-band__art :global(.placard__text) { max-width: 9ch; }
  @media (max-width: 760px) { .join-band__inner { grid-template-columns: 1fr; } .join-band__art { display: none; } }
</style>
