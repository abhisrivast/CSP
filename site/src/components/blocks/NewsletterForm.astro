---
// Newsletter sign-up via Netlify Forms. Asks age band first (safeguarding + India DPDP: under-18s need
// verifiable parental consent), collects only an email, and records explicit consent.
export interface Props { id: string; compact?: boolean }
const { id, compact = false } = Astro.props;
const f = (name: string) => `${id}-${name}`;
---
<form class:list={['newsletter', { 'newsletter--compact': compact }]} name="newsletter" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value="newsletter" />
  <input type="hidden" name="source" value={id} />
  <p class="visually-hidden"><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <div class="field">
    <label for={f('age')}>How old are you?</label>
    <select class="select" id={f('age')} name="age_band" required>
      <option value="">Choose one</option>
      <option value="18-24">18 to 24</option>
      <option value="25-34">25 to 34</option>
      <option value="35+">35 or older</option>
      <option value="under-18">Under 18</option>
    </select>
    <p class="hint">Under 18? We'll point you to our learning resources instead. Sign-ups for under-18s need a parent's consent.</p>
  </div>

  <div class="field">
    <label for={f('email')}>Email</label>
    <input class="input" id={f('email')} type="email" name="email" autocomplete="email" required inputmode="email" />
  </div>

  <label class="check">
    <input type="checkbox" name="consent" value="yes" required />
    <span>Yes, email me CSP's monthly newsletter. I can unsubscribe any time. <a href="/privacy/">How we use your data</a>.</span>
  </label>

  <button class="btn btn--paper" type="submit">Sign me up <span class="arrow" aria-hidden="true">→</span></button>
</form>

<script>
  // Under-18s are routed to free resources instead of signing up (parental consent rule).
  document.querySelectorAll<HTMLFormElement>('form.newsletter').forEach((form) => {
    form.addEventListener('submit', (e) => {
      const age = (form.elements.namedItem('age_band') as HTMLSelectElement | null)?.value;
      if (age !== 'under-18') return;
      e.preventDefault();
      let note = form.querySelector<HTMLParagraphElement>('.newsletter__minor');
      if (!note) {
        note = document.createElement('p');
        note.className = 'newsletter__minor';
        note.setAttribute('role', 'status');
        form.append(note);
      }
      note.innerHTML = 'Thanks for wanting in! Under-18s need a parent or guardian to sign up for you. Everything here is free to read now: start with <a href="/resources/">our guides</a>.';
    });
  });
</script>

<style>
  .newsletter__minor { padding: 12px 14px; background: var(--marigold); color: var(--ink); font-weight: 600; }
  .newsletter__minor :global(a) { color: var(--ink); }
  .newsletter { display: grid; gap: 16px; max-width: 480px; }
  .newsletter .hint { color: var(--muted); }
  .newsletter .btn { justify-self: start; }
</style>
