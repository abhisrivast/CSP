---
// Homepage hero: label row, poster-scale H1 pasted over a taped collage of four duotone documentary photos,
// the badge as a sticker, the engine in one line, two calls to action and an honest photo key.
import { Image } from 'astro:assets';
import badge from '../../assets/brand/csp-badge.png';
import Photo from '../media/Photo.astro';
import Annotation from '../ui/Annotation.astro';
import Swash from './Swash.astro';
import { SITE } from '../../data/site';
import { HERO_PHOTOS } from './home';

const [main, p2, p3, p4] = HERO_PHOTOS;
---
<section class="hero grain" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <p class="label-row label hero__labels">
      <span class="hero__kicker">A Fourth Wave feminist movement</span>
      <span>Founded in India, 2026</span>
      <span>For a global generation</span>
    </p>

    <h1 class="hero__title" id="hero-title">
      <span class="hero__line">We’re</span>{' '}
      <span class="hero__line">building</span>{' '}
      <span class="hero__line">the <span class="hero__red">Fourth</span></span>{' '}
      <span class="hero__line hero__line--last"><span class="hero__red">Wave.</span><Swash class="hero__swash" /></span>
    </h1>

    <div class="hero__art">
      <div class="collage">
        <div class="collage__p collage__p--1">
          <Photo id={main.id} tone={main.tone} alt={main.alt} position={main.position} aspect="4 / 3" caption={false} priority tape="both"
            widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 36vw, 78vw" />
          <span class="collage__n" aria-hidden="true">1</span>
        </div>
        <div class="collage__p collage__p--2">
          <Photo id={p2.id} tone={p2.tone} alt={p2.alt} position={p2.position} aspect="4 / 3" caption={false} tape="tl"
            widths={[240, 360, 480, 640]} sizes="(min-width: 900px) 22vw, 44vw" />
          <span class="collage__n" aria-hidden="true">2</span>
        </div>
        <div class="collage__p collage__p--3">
          <Photo id={p3.id} tone={p3.tone} alt={p3.alt} position={p3.position} aspect="3 / 2" caption={false} tape="tr"
            widths={[240, 360, 480, 640]} sizes="(min-width: 900px) 24vw, 46vw" />
          <span class="collage__n" aria-hidden="true">3</span>
        </div>
        <div class="collage__p collage__p--4">
          <Photo id={p4.id} tone={p4.tone} alt={p4.alt} position={p4.position} aspect="1 / 1" caption={false}
            widths={[240, 360, 480]} sizes="(min-width: 900px) 15vw, 30vw" />
          <span class="collage__n" aria-hidden="true">4</span>
        </div>
        <div class="collage__badge">
          <Image src={badge} alt="Cultural Shock Party badge: a woman breaking a chain above a crowd of marchers" width={220} height={220} densities={[1, 2]} loading="lazy" decoding="async" />
        </div>
      </div>
      <ol class="hero__key" aria-label="In the photographs">
        {HERO_PHOTOS.map((p) => <li>{p.key}</li>)}
        <li class="hero__key-credit"><a href="/credits/">Photo credits</a></li>
      </ol>
    </div>

    <div class="hero__foot">
      <p class="hero__lead">{SITE.shortMission}</p>
      <div class="hero__ctas">
        <a class="btn" href="/join/">Join the movement <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--paper" href="/manifesto/">Read the manifesto</a>
      </div>
      <div class="hero__note">
        <Annotation text="this is where you come in" arrow="up" tilt={-3} width="20ch" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(18px, 3vw, 36px) clamp(44px, 6vw, 80px); overflow: hidden; }
  .hero__grid { position: relative; z-index: 2; display: grid; gap: 0 clamp(16px, 2.4vw, 32px); grid-template-columns: minmax(0, 1fr); }
  .hero__labels { color: var(--ink); }
  .hero__kicker { color: var(--red-ink); }

  /* headline: condensed poster type; each line is a strip of paper pasted over the collage */
  .hero__title {
    position: relative; z-index: 4; margin-top: clamp(18px, 3vw, 34px);
    font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; letter-spacing: -0.015em;
    font-size: clamp(3.9rem, 20vw, 8.4rem); line-height: .84;
    display: grid; justify-items: start;
  }
  .hero__line { display: block; background: var(--paper) url('/textures/grain.png') 0 0 / 160px; padding: .02em .08em 0 0; }
  .hero__red { color: var(--red); }
  .hero__line--last { position: relative; z-index: 0; padding-bottom: .2em; }
  .hero__swash { position: absolute; left: -.04em; right: -.34em; bottom: -.04em; width: auto; height: .4em; z-index: -1; }
  .hero__line--last .hero__red { position: relative; z-index: 1; }

  /* collage */
  .hero__art { position: relative; z-index: 1; margin-top: clamp(-36px, -4vw, -18px); }
  .collage { position: relative; aspect-ratio: 1 / .98; }
  .collage__p { position: absolute; }
  .collage__p :global(.photo__img) { box-shadow: 6px 8px 0 rgba(29, 28, 24, .18); }
  .collage__p--1 { left: 13%; top: 7%; width: 72%; z-index: 2; transform: rotate(2.2deg); }
  .collage__p--2 { left: 0; top: 55%; width: 44%; z-index: 3; transform: rotate(-5deg); }
  .collage__p--3 { right: 0; top: 63%; width: 47%; z-index: 4; transform: rotate(3.4deg); }
  .collage__p--4 { right: 1%; top: 0; width: 27%; z-index: 3; transform: rotate(-4deg); }
  .collage__p--4 :global(.photo__img) { border: 7px solid var(--paper-light); }
  .collage__n {
    position: absolute; z-index: 5; left: 8px; bottom: 8px; display: grid; place-items: center; width: 26px; height: 26px;
    background: var(--paper-light); color: var(--ink); border: 2px solid var(--ink); border-radius: 50%;
    font-weight: 900; font-size: .8rem; line-height: 1;
  }
  .collage__badge {
    position: absolute; z-index: 6; left: 37%; top: 49%; width: 25%; transform: rotate(11deg);
    border-radius: 50%; background: var(--paper-light); padding: 5px; box-shadow: 5px 7px 0 rgba(29, 28, 24, .28);
  }
  .collage__badge :global(img) { width: 100%; height: auto; border-radius: 50%; }
  .hero__key {
    position: relative; z-index: 2; list-style: none; padding: 0; margin-top: 22px; display: flex; flex-wrap: wrap; gap: 4px 14px;
    font-size: .78rem; line-height: 1.35; color: var(--muted); counter-reset: k;
  }
  .hero__key li { counter-increment: k; }
  .hero__key li:not(.hero__key-credit)::before { content: counter(k) ' '; font-weight: 900; color: var(--ink); }
  .hero__key a { color: var(--ink-soft); }

  /* lead + CTAs */
  .hero__foot { position: relative; z-index: 4; margin-top: clamp(26px, 3vw, 34px); display: grid; gap: 22px; align-content: start; }
  .hero__lead {
    font-family: var(--font-serif); font-size: clamp(1.2rem, 1.8vw, 1.5rem); line-height: 1.35; max-width: 31ch; color: var(--ink);
    background: var(--paper) url('/textures/grain.png') 0 0 / 160px; padding-right: .3em;
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 14px 18px; }
  .hero__note { margin-top: -10px; padding-left: 26px; }
  .hero__note :global(.annot) { gap: 0; }

  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto auto 1fr; }
    .hero__labels { grid-column: 1 / -1; grid-row: 1; }
    .hero__title { grid-column: 1 / 9; grid-row: 2; font-size: clamp(5rem, 9.3vw, 9.6rem); }
    .hero__art { grid-column: 6 / 13; grid-row: 2 / 4; margin-top: clamp(12px, 2vw, 28px); }
    .hero__foot { grid-column: 1 / 7; grid-row: 3; }
    .hero__key { padding-left: 4%; }
    .collage { aspect-ratio: 1 / .9; }
  }
  @media (max-width: 899px) {
    /* on phones the photo key moves below the calls to action */
    .hero__art { display: contents; }
    .collage { position: relative; z-index: 1; max-width: 640px; margin-top: clamp(-36px, -4vw, -18px); }
    .hero__key { order: 1; max-width: 640px; padding-top: 14px; border-top: 1px solid var(--line-soft); }
    .collage__badge { width: 27%; left: 35%; top: 50%; }
  }
  @media (max-width: 899px) {
    /* stacked, so a wrapped line never starts with the "/" separator */
    .hero__labels { display: grid; gap: 5px; }
    .hero__labels > * + *::before { display: none; }
  }
  @media (max-width: 520px) {
    .collage { aspect-ratio: 1 / 1.08; }
    .collage__p--1 { left: 6%; top: 9%; width: 84%; }
    .collage__p--2 { top: 59%; width: 48%; }
    .collage__p--3 { top: 66%; width: 50%; }
    .collage__p--4 { width: 30%; top: 0; }
    .collage__n { width: 22px; height: 22px; font-size: .72rem; left: 6px; bottom: 6px; }
    .hero__ctas .btn { flex: 1 1 100%; justify-content: center; }
  }
</style>
