---
// The six programmes (names fixed, STRATEGY §6) as photo cards, each linking to its section on /what-we-do/.
import SectionHead from '../ui/SectionHead.astro';
import Photo from '../media/Photo.astro';
import Stamp from '../ui/Stamp.astro';
import { PROGRAMMES } from './home';
---
<section class="section progs" aria-labelledby="progs-title">
  <div class="wrap">
    <div class="progs__head">
      <SectionHead num="05" label="What we do" id="progs-title" lead="Every programme plugs into one stage of the engine. All six are new, and all six are being built now, in public.">
        Six programmes. <span class="progs__red">One engine.</span>
      </SectionHead>
      <a class="btn btn--ink progs__cta" href="/what-we-do/">See what each one makes first <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <ol class="progs__grid" role="list">
      {PROGRAMMES.map((p, i) => (
        <li class="prog">
          <div class="prog__pic">
            <Photo id={p.photo} tone={p.tone} alt={p.alt} position={p.position} aspect="4 / 3" caption={false}
              widths={[240, 360, 560, 800]} sizes="(min-width: 1000px) 30vw, (min-width: 640px) 45vw, 30vw" />
            <span class="prog__stamp"><Stamp text="Now building" sub="2026" tilt={i % 2 ? 7 : -7} /></span>
          </div>
          <div class="prog__body">
            <p class="prog__meta"><span class="prog__num" aria-hidden="true">{p.num}</span><span class="label prog__stage"><span class="prog__stage-k">Engine stage · </span>{p.stage}</span></p>
            <h3 class="prog__name"><a href={`/what-we-do/#${p.id}`}>{p.name}</a></h3>
            <p class="prog__line">{p.line}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="progs__note">Pictured: other people’s reading, workshops and marches, in India and beyond, used as illustration. None shows a CSP event. <a href="/credits/">Photo credits</a></p>
  </div>
</section>

<style>
  .progs__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px 40px; align-items: end; }
  .progs__head :global(.section-head) { margin-bottom: 0; }
  .progs__red { color: var(--red); white-space: nowrap; }
  .progs__cta { margin-bottom: 6px; }
  .progs__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px) clamp(18px, 2.4vw, 32px); margin-top: clamp(36px, 5vw, 60px); counter-reset: p; }
  .prog { position: relative; display: grid; gap: 14px; align-content: start; padding-bottom: 18px; border-bottom: 3px solid var(--ink); }
  .prog__pic { position: relative; }
  .prog__pic :global(.photo__img img) { transition: transform .5s var(--ease); }
  .prog:hover .prog__pic :global(.photo__img img) { transform: scale(1.04); }
  .prog__stamp { position: absolute; right: 10px; top: 10px; z-index: 3; background: var(--paper-light); }
  .prog__stamp :global(.stamp__text) { font-size: .95rem; }
  .prog__stamp :global(.stamp__sub) { font-size: .78rem; letter-spacing: .14em; }
  .prog__body { display: grid; gap: 8px; }
  .prog__meta { display: flex; align-items: center; gap: 10px; }
  .prog__num { font-weight: 900; font-stretch: var(--display-stretch); font-size: 1.9rem; line-height: .8; color: var(--red-ink); }
  .prog__stage { color: var(--ink-soft); padding-left: 10px; border-left: 1.5px solid var(--line-soft); }
  .prog__name { font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(1.75rem, 2.6vw, 2.4rem); line-height: .9; }
  .prog__name a { color: var(--ink); text-decoration: none; }
  .prog__name a::after { content: ''; position: absolute; inset: 0; z-index: 4; }
  .prog__name a:focus-visible { outline: none; box-shadow: none; }
  .prog:has(a:focus-visible) { outline: 3px solid var(--ink); outline-offset: 6px; }
  .prog:hover .prog__name a { text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 3px; }
  .prog__line { color: var(--ink-soft); font-size: 1rem; line-height: 1.45; max-width: 36ch; }
  .progs__note { margin-top: 18px; font-size: .86rem; line-height: 1.45; color: var(--ink-soft); max-width: 70ch; }
  .progs__note a { color: var(--ink); }
  @media (max-width: 1200px) { .prog__stage-k { display: none; } }
  @media (max-width: 1000px) { .progs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .progs__head { grid-template-columns: 1fr; } .progs__cta { justify-self: start; } }
  @media (max-width: 640px) {
    .progs__grid { grid-template-columns: 1fr; gap: 0; }
    .prog { grid-template-columns: 34% minmax(0, 1fr); gap: 14px; padding-block: 16px; border-bottom-width: 1px; }
    .prog:first-child { border-top: 3px solid var(--ink); }
    .prog__stamp { display: none; }
    .prog__name { font-size: 1.55rem; }
    .prog__line { font-size: .94rem; }
  }
</style>
