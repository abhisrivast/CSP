---
// Hand-drawn brush swash in the spirit of the brand's inspiration poster: a dry-brush stroke shaped like a wave,
// drawn under "Wave." in the homepage headline. Purely decorative.
export interface Props { class?: string; color?: string }
const { class: cls, color = 'var(--ink)' } = Astro.props;
---
<svg class:list={['swash', cls]} viewBox="0 0 640 72" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path
    fill={color}
    d="M4 40 C 30 30, 70 14, 118 12 C 170 10, 198 32, 248 35 C 302 38, 330 14, 386 9 C 440 4, 474 26, 524 28 C 566 30, 602 20, 636 10
       L 638 22 C 608 38, 570 54, 520 55 C 464 56, 436 38, 388 40 C 336 42, 306 66, 246 66 C 186 66, 162 46, 120 46 C 80 46, 44 56, 8 60 C 2 56, 0 46, 4 40 Z"
  />
  <g fill="none" stroke="var(--paper)" stroke-linecap="round" class="swash__dry">
    <path d="M150 28 C 182 28, 206 44, 238 50" stroke-width="2.2" />
    <path d="M296 48 C 330 30, 362 22, 400 21" stroke-width="2" />
    <path d="M300 56 C 332 44, 356 36, 392 33" stroke-width="1.2" />
    <path d="M424 25 C 458 25, 490 39, 528 42" stroke-width="2.4" />
    <path d="M552 38 C 578 36, 604 28, 630 18" stroke-width="1.8" />
    <path d="M560 46 C 586 42, 606 36, 628 28" stroke-width="1.1" />
    <path d="M56 44 C 78 36, 98 30, 120 28" stroke-width="1.4" />
  </g>
  <g fill={color}>
    <circle cx="628" cy="42" r="3" />
    <circle cx="614" cy="52" r="1.8" />
    <circle cx="636" cy="32" r="1.5" />
  </g>
</svg>

<style>
  .swash { display: block; overflow: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .swash { clip-path: inset(0 100% 0 0); animation: swash-draw .9s .35s var(--ease) forwards; }
  }
  @keyframes swash-draw { to { clip-path: inset(0 0 0 0); } }
</style>
