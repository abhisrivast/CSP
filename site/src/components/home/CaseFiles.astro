---
// Case studies: three featured files (India first) plus the "15 movements, 8 lessons" index.
// Pictures come from ./picks.ts: the homepage pick, else the case's card photo, else its typographic poster.
// A photo that is not of the movement itself says so in a small "Photo:" tag.
import SectionHead from '../ui/SectionHead.astro';
import Photo from '../media/Photo.astro';
import Stamp from '../ui/Stamp.astro';
import CasePoster from '../cases/CasePoster.astro';
import { CROSS_LESSONS } from '../cases/cross-lessons';
import { FEATURED_CASES } from './home';
import { casePicks } from './picks';

const { cases, picks } = await casePicks();
const num = new Map(cases.map((c, i) => [c.id, String(i + 1).padStart(2, '0')]));
const rest = cases.filter((c) => !FEATURED_CASES.includes(c.id));
const india = cases.filter((c) => c.data.region === 'India').length;
---
<section class="section cases" aria-labelledby="cases-title">
  <div class="wrap">
    <SectionHead num="07" label="Case studies" id="cases-title" lead={`${cases.length} movements, ${india} of them in India: what they did, what changed, what didn’t, and what we can learn from them.`}>
      What movements <span class="cases__red">teach us</span>
    </SectionHead>

    <div class="cases__grid">
      {picks.map(({ c, photo, tone, alt, note, poster }, i) => {
        const aspect = i === 0 ? '3 / 2' : '16 / 10';
        return (
          <article class:list={['file', { 'file--lead': i === 0 }]}>
            <div class="file__pic">
              {photo ? (
                <Photo id={photo} tone={tone} alt={alt} caption={false} aspect={aspect}
                  widths={i === 0 ? [360, 560, 800, 1100] : [360, 560, 800]} sizes={i === 0 ? '(min-width: 1000px) 56vw, 92vw' : '(min-width: 1000px) 34vw, 92vw'} />
              ) : (
                poster && <CasePoster poster={poster} aspect={aspect} />
              )}
              {photo && note && <span class="file__note">Photo: {note}</span>}
              <span class="file__stamp"><Stamp text={`Case ${num.get(c.id)}`} sub={c.data.region === 'India' ? 'India' : c.data.place.split(',').pop()?.trim()} tilt={i === 0 ? -8 : 6} color={i === 0 ? 'red' : 'ink'} /></span>
            </div>
            <div class="file__body">
              <p class="label-row label file__meta"><span>{c.data.place}</span><span>{c.data.years}</span></p>
              <h3 class="file__title"><a href={`/case-studies/${c.id}/`}>{c.data.title}</a></h3>
              <p class="file__dek">{c.data.dek}</p>
            </div>
          </article>
        );
      })}

      <aside class="ledger ground-ink" aria-labelledby="ledger-title">
        <h3 class="ledger__title" id="ledger-title"><span class="ledger__n">{cases.length}</span> movements, <span class="nw"><span class="ledger__n">{CROSS_LESSONS.length}</span> lessons</span></h3>
        <ol class="ledger__lessons" role="list">
          {CROSS_LESSONS.map((l, i) => <li><span class="ledger__i" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{l.title}</li>)}
        </ol>
        <a class="btn btn--paper ledger__btn" href="/case-studies/">Read all {cases.length} case files <span class="arrow" aria-hidden="true">→</span></a>
      </aside>
    </div>

    <nav class="cases__index" aria-label="More case studies">
      <p class="label">Also in the files</p>
      <ul role="list">
        {rest.map((c) => <li><a href={`/case-studies/${c.id}/`}><span class="cases__num" aria-hidden="true">{num.get(c.id)}</span>{c.data.title}</a></li>)}
      </ul>
    </nav>
  </div>
</section>

<style>
  .cases__red { color: var(--red); }
  .cases__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(22px, 3vw, 40px) clamp(18px, 2.4vw, 32px); }
  .file { position: relative; display: grid; gap: 16px; align-content: start; }
  .file--lead { grid-column: 1 / 8; grid-row: 1 / 3; }
  .file:nth-of-type(2) { grid-column: 8 / 13; grid-row: 1; }
  .file:nth-of-type(3) { grid-column: 8 / 13; grid-row: 2; }
  .file__pic { position: relative; }
  .file__pic :global(.photo__img img) { transition: transform .5s var(--ease); }
  .file:hover .file__pic :global(.photo__img img) { transform: scale(1.03); }
  .file__stamp { position: absolute; left: 12px; bottom: -14px; z-index: 3; background: var(--paper); }
  .file__note {
    position: absolute; z-index: 3; right: 0; bottom: 0; max-width: calc(100% - 150px); padding: 5px 9px 4px;
    background: var(--paper-light); color: var(--ink); font-size: .72rem; font-weight: 700; line-height: 1.25;
    border-top: 2px solid var(--ink); border-left: 2px solid var(--ink);
  }
  .file__pic :global(.cposter__frame) { transition: transform .3s var(--ease); }
  .file:hover .file__pic :global(.cposter__frame) { transform: rotate(-.6deg); }
  .file__body { display: grid; gap: 10px; padding-top: 8px; }
  .file__meta { color: var(--ink-soft); }
  .file__title { font-weight: 900; font-stretch: var(--head-stretch); font-size: clamp(1.35rem, 2vw, 1.7rem); line-height: 1.04; }
  .file--lead .file__title { font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(2rem, 3.8vw, 3.3rem); line-height: .9; max-width: 16ch; }
  .file__title a { color: var(--ink); text-decoration: none; }
  .file__title a::after { content: ''; position: absolute; inset: 0; z-index: 4; }
  .file__title a:focus-visible { outline: none; box-shadow: none; }
  .file:has(a:focus-visible) { outline: 3px solid var(--ink); outline-offset: 6px; }
  .file:hover .file__title a { text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 3px; }
  .file__dek { color: var(--ink-soft); line-height: 1.45; max-width: 52ch; }
  .file--lead .file__dek { font-family: var(--font-serif); font-size: 1.15rem; color: var(--ink); }

  .ledger {
    grid-column: 1 / -1; grid-row: 3; display: grid; grid-template-columns: minmax(15.5rem, 1fr) minmax(0, 2.3fr); grid-template-rows: auto 1fr;
    gap: 14px clamp(24px, 4vw, 56px); align-items: start; padding: clamp(22px, 3vw, 34px); margin-top: 12px; box-shadow: 6px 6px 0 var(--red);
  }
  .ledger__lessons { grid-column: 2; grid-row: 1 / 3; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; }
  .ledger__btn { grid-column: 1; grid-row: 2; align-self: end; }
  .ledger__title { font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase; font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: .9; }
  .ledger__n { color: var(--coral); }
  .nw { white-space: nowrap; }
  .ledger__lessons { display: grid; row-gap: 0; }
  .ledger__lessons li { display: grid; grid-template-columns: 2.2em minmax(0, 1fr); gap: 6px; padding: 8px 0; border-top: 1px solid rgba(243, 236, 220, .25); font-weight: 700; font-size: .98rem; line-height: 1.3; }
  .ledger__i { color: var(--marigold); font-weight: 900; font-stretch: 80%; }
  .ledger__btn { justify-self: start; margin-top: 6px; white-space: nowrap; }

  .cases__index { margin-top: clamp(32px, 5vw, 56px); padding-top: 14px; border-top: 3px solid var(--ink); display: grid; gap: 12px; }
  .cases__index ul { display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .cases__index a {
    display: inline-flex; align-items: baseline; gap: 8px; padding: 8px 12px 7px; min-height: 44px; border: 1.5px solid var(--ink);
    color: var(--ink); text-decoration: none; font-weight: 700; font-size: .92rem; line-height: 1.2; background: var(--paper-light);
  }
  .cases__index a:hover { background: var(--ink); color: var(--paper); }
  .cases__num { font-weight: 900; color: var(--red-ink); font-size: .8rem; }
  .cases__index a:hover .cases__num { color: var(--coral); }

  @media (max-width: 1000px) {
    .cases__grid { grid-template-columns: 1fr 1fr; }
    .file--lead { grid-column: 1 / -1; grid-row: auto; }
    .file:nth-of-type(2), .file:nth-of-type(3) { grid-column: span 1; grid-row: auto; }
    .ledger { grid-column: 1 / -1; grid-row: auto; grid-template-columns: 1fr; }
    .ledger__lessons, .ledger__btn { grid-column: 1; grid-row: auto; }
  }
  @media (max-width: 640px) {
    .cases__grid { grid-template-columns: 1fr; }
    .file:nth-of-type(2), .file:nth-of-type(3) { grid-column: 1 / -1; }
    .cases__index ul { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .cases__index a { display: flex; height: 100%; font-size: .84rem; padding: 8px 10px 7px; }
    .ledger__lessons { grid-template-columns: 1fr; }
    .ledger__btn { white-space: normal; }
    .file--lead .file__meta { display: grid; gap: 4px; }
    .file--lead .file__meta > * + *::before { display: none; }
  }
</style>
