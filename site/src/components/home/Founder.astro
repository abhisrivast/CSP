---
// "Started by Rubby Singh": verified facts only (research/founder.md §7). No photo yet, so a designed
// portrait placard and a library-style catalogue card for the book.
import SectionHead from '../ui/SectionHead.astro';
import Stamp from '../ui/Stamp.astro';
import { FOUNDER } from '../../data/site';

const book = FOUNDER.book;
const [bookMain, bookSub] = book.title.split(':').map((s) => s.trim());
const published = new Date(book.published).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const isbn = `${book.isbn13.slice(0, 3)}-${book.isbn13.slice(3)}`;
---
<section class="section founder ground-green grain" aria-labelledby="founder-title">
  <div class="wrap founder__inner">
    <div class="founder__text">
      <SectionHead num="08" label="Our founder" id="founder-title">Started by <span class="founder__name">Rubby Singh</span></SectionHead>
      <p class="founder__lead">
        Rubby Singh founded Cultural Shock Party in 2026. She describes herself as an author, a book reviewer and a social worker.
      </p>
      <p class="founder__body">
        Her novel, <cite>{book.title}</cite>, is about how the idea of a “defective womb” and everyday patriarchy shape
        girls’ lives, and the awakening that undoes it. The movement shares its starting point: what a society treats as
        normal can change.
      </p>
      <p class="founder__small">We publish only what we can source. Her own story of her work is hers to tell.</p>
      <a class="btn btn--paper" href={`/about/${FOUNDER.slug}/`}>Meet Rubby Singh <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <div class="founder__art" aria-hidden="true">
      <div class="portrait">
        <p class="label portrait__label"><span>File 01</span><span>Founder</span></p>
        <p class="portrait__name"><span>Rubby</span><span>Singh</span></p>
        <p class="portrait__hand hand">started this in 2026</p>
        <span class="portrait__stamp"><Stamp text="Founder" sub="2026" color="green" tilt={-12} round /></span>
      </div>
      <div class="catalogue">
        <p class="catalogue__head"><span>{book.isbn13.slice(-4)}</span><span>Novel</span></p>
        <p class="catalogue__author">Singh, Rubby.</p>
        <p class="catalogue__title"><b>{bookMain}</b>: {bookSub}</p>
        <p>{book.publisher}, {published}. {book.pages} pp.</p>
        <p>ISBN {isbn}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .founder { overflow-x: clip; }
  .founder__inner { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .founder__name { color: var(--marigold); white-space: nowrap; }
  .founder__text { display: grid; gap: 18px; justify-items: start; }
  .founder__text :global(.section-head) { margin-bottom: 6px; width: 100%; }
  .founder__lead { font-family: var(--font-serif); font-size: clamp(1.35rem, 2.2vw, 1.85rem); line-height: 1.25; max-width: 30ch; }
  .founder__body { font-size: 1.05rem; line-height: 1.55; max-width: 50ch; color: var(--ink-soft); }
  .founder__body cite { font-style: italic; color: var(--paper); }
  .founder__small { font-size: .9rem; color: var(--muted); }

  .founder__art { position: relative; min-height: 480px; }
  .portrait {
    position: relative; width: min(100%, 380px); margin-left: auto; aspect-ratio: 4 / 5; display: grid; grid-template-rows: auto auto auto 1fr;
    padding: 22px 22px 20px; background: var(--paper-light); color: var(--ink); transform: rotate(2.5deg);
    box-shadow: 8px 10px 0 rgba(0, 0, 0, .28);
    background-image: repeating-linear-gradient(-45deg, transparent 0 14px, rgba(205, 46, 43, .06) 14px 15px);
  }
  .portrait::before {
    content: ''; position: absolute; top: -12px; left: 50%; width: 110px; height: 28px; transform: translateX(-50%) rotate(-3deg);
    background: rgba(241, 179, 98, .85); clip-path: polygon(3% 0, 97% 8%, 100% 92%, 0 100%);
  }
  .portrait__label { display: flex; justify-content: space-between; border-bottom: 1.5px dashed var(--ink); padding-bottom: 8px; }
  .portrait__name {
    margin-top: 16%; display: grid; font-weight: 900; font-stretch: var(--display-stretch); text-transform: uppercase;
    font-size: clamp(4.2rem, 8vw, 6.6rem); line-height: .8; letter-spacing: -.02em; color: var(--ink);
  }
  .portrait__name span + span { color: var(--red); }
  .portrait__hand { justify-self: end; font-size: 1.7rem; color: var(--red-ink); transform: rotate(-4deg); margin: 10px 4px 0 0; }
  .portrait__stamp { position: absolute; right: -30px; top: 21%; background: var(--paper-light); border-radius: 50%; }
  .portrait__stamp :global(.stamp__text) { font-size: 1.15rem; }
  .portrait__stamp :global(.stamp__sub) { font-size: .8rem; }
  @media (max-width: 420px) {
    .portrait__stamp { right: -20px; transform: scale(.86); transform-origin: 100% 50%; }
  }

  .catalogue {
    position: absolute; left: 0; bottom: -24px; width: min(74%, 320px); padding: 14px 18px 16px; transform: rotate(-4deg);
    background: #FBF7EE; color: var(--ink); font-family: 'Courier New', ui-monospace, monospace; font-size: .82rem; line-height: 1.45;
    box-shadow: 5px 6px 0 rgba(0, 0, 0, .25);
    background-image: linear-gradient(transparent 27px, rgba(179, 38, 30, .5) 27px 28px, transparent 28px), repeating-linear-gradient(transparent 0 18px, rgba(29, 28, 24, .07) 18px 19px);
  }
  .catalogue::after { content: ''; position: absolute; left: 50%; bottom: 10px; width: 12px; height: 12px; border-radius: 50%; background: var(--green); transform: translateX(-50%); }
  .catalogue__head { display: flex; justify-content: space-between; font-weight: 700; margin-bottom: 8px; }
  .catalogue__author { font-weight: 700; }
  .catalogue__title b { font-weight: 700; }
  .catalogue p:last-child { padding-bottom: 14px; }

  @media (max-width: 900px) {
    .founder__inner { grid-template-columns: 1fr; }
    .founder__art { min-height: 0; padding-bottom: 150px; max-width: 460px; }
    .portrait { margin-left: 0; width: min(88%, 360px); }
    .catalogue { left: auto; right: 0; }
    /* phones: the stamp sits beside the name and the note moves under it, so neither covers the other */
    .portrait__stamp { top: 19%; right: -16px; }
    .portrait__hand { justify-self: start; margin: 14px 0 0 2px; }
  }
</style>
