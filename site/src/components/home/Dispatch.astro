---
// A dated "wire" of real items on the site. Static, no marquee: a row on desktop, a list on phones.
export type DispatchItem = { tag: string; title: string; href: string; date?: string; iso?: string };
export interface Props { items: DispatchItem[]; date: string; iso: string }
const { items, date, iso } = Astro.props;
---
<section class="dispatch ground-ink" aria-labelledby="dispatch-title">
  <div class="wrap dispatch__inner">
    <h2 class="label dispatch__head" id="dispatch-title">
      <span class="dispatch__live" aria-hidden="true"></span>
      <span>Dispatches</span>{' '}
      <time datetime={iso}><span class="visually-hidden">, </span>{date}</time>
    </h2>
    <ul class="dispatch__list" role="list">
      {items.map((it) => (
        <li>
          <a class="dispatch__item" href={it.href}>
            <span class="label dispatch__tag">{it.tag}</span>
            <span class="dispatch__title">{it.title}</span>
            {it.date && <time class="label dispatch__date" datetime={it.iso}>{it.date}</time>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .dispatch { position: relative; z-index: 3; padding-bottom: 24px; }
  .dispatch__inner { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 28px; align-items: stretch; }
  .dispatch__head {
    display: flex; flex-direction: column; justify-content: center; gap: 4px; padding: 18px 26px 18px 0;
    border-right: 1px solid rgba(243, 236, 220, .3); color: var(--paper);
  }
  .dispatch__head time { color: #CFC6B4; letter-spacing: .1em; }
  .dispatch__live { width: 10px; height: 10px; border-radius: 50%; background: var(--coral); box-shadow: 0 0 0 4px rgba(240, 103, 94, .25); margin-bottom: 4px; }
  .dispatch__list { display: grid; grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr)); }
  .dispatch__list li + li { border-left: 1px solid rgba(243, 236, 220, .3); }
  .dispatch__item {
    display: grid; align-content: start; gap: 6px; height: 100%; padding: 16px 18px 18px; text-decoration: none; color: var(--paper);
    transition: background .15s var(--ease);
  }
  .dispatch__item:hover { background: rgba(243, 236, 220, .08); color: var(--paper); }
  .dispatch__item:hover .dispatch__title { text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; }
  .dispatch__tag { color: var(--marigold); }
  .dispatch__title { font-weight: 800; font-stretch: 85%; font-size: 1.02rem; line-height: 1.2; }
  .dispatch__date { color: #CFC6B4; letter-spacing: .1em; }
  @media (max-width: 1100px) {
    .dispatch__inner { grid-template-columns: 1fr; }
    .dispatch__head { flex-direction: row; align-items: center; gap: 12px; padding: 14px 0 12px; border-right: 0; border-bottom: 1px solid rgba(243, 236, 220, .3); }
    .dispatch__live { margin: 0; }
    .dispatch__list { grid-template-columns: 1fr; }
    .dispatch__list li + li { border-left: 0; border-top: 1px solid rgba(243, 236, 220, .2); }
    .dispatch__item { grid-template-columns: 6.6rem minmax(0, 1fr); gap: 2px 12px; padding: 12px 0; }
    .dispatch__tag { grid-row: 1 / 3; padding-top: 3px; }
  }
</style>
