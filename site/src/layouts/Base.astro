---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource/caveat-brush/400.css';
import '../styles/global.css';
import Head from '../components/seo/Head.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE } from '../data/site';
import type { Props as HeadProps } from '../components/seo/Head.astro';

export type Props = HeadProps & { bodyClass?: string };
const { bodyClass, ...head } = Astro.props;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head {...head} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
